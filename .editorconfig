root = true
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{cs,xaml}]
trim_trailing_whitespace = true
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.CA1822.severity = none
# Allow plural flag-enum type names (BindingFlags / FrameFlags idiom).
dotnet_diagnostic.CA1711.severity = none
# "Error" collides with VB.NET reserved keyword; this is a C#-only project.
dotnet_diagnostic.CA1716.severity = none
# Result<T>.Ok / .Fail are intentional static factories — discriminated-union pattern.
dotnet_diagnostic.CA1000.severity = none
# TokenType.Keyword_BO_, _SG_, _BS_, _NS_DESC_ etc. — underscores ARE the lexeme,
# matching the actual DBC grammar. CA1707 / CA1720 (Integer, String match BCL type names).
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1720.severity = none

# --- Intentionally downgraded under AnalysisMode=Recommended (perf-only rules) ---
# CA1848/CA1873: converting every _logger.LogX(...) call to the [LoggerMessage]
#   source-generated delegate form is a large per-area refactor (154+ sites) and
#   logging is not on this app's hot paths. Tracked as a follow-up; revisit per area.
# CA1859: "use concrete types" rewrites public/protected signatures for a micro
#   optimisation that is irrelevant at this app's call volumes, and it fights the
#   interface-based abstractions the codebase deliberately uses.
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.CA1873.severity = suggestion
dotnet_diagnostic.CA1859.severity = suggestion

[*.Tests.cs]
# xUnit convention: underscored BDD-style test method names (Method_Condition_Expected).
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1014.severity = none
