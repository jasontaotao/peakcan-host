<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit convention: underscore-separated BDD test method names trigger CA1707. -->
    <!-- Negative-path tests create instances purely to assert exceptions (CA1806 false-positive). -->
    <NoWarn>$(NoWarn);CA1707;CA1014;CA1806</NoWarn>
    <!-- Task 19: collect cobertura coverage report for CI artifact
         upload. Per-test-project <Threshold> is intentionally not
         set here: the coverlet.collector V3 threshold check operates
         on the union of all referenced assemblies (e.g. Infrastructure.Tests
         would also count Core types it transitively touches), which
         produces a per-test-project number that is hard to reason
         about. Instead, the CI workflow uploads the per-test-project
         cobertura XMLs and a maintainer inspects the per-package
         rates manually (or wires a follow-up report generator). -->
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutput>../..//coverage/core-coverage</CoverletOutput>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- System.Text.Encoding.CodePages 在 .NET 10 共享框架中自动可用（NU1510），
         不再显式引用；GBK 读取生产 DBC 直接使用 CodePagesEncodingProvider。 -->
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PeakCan.Host.Core\PeakCan.Host.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\PeakCan.Host.App.Tests\Fixtures\Can\*.asc" LinkBase="Fixtures\Can\" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- S2-T7: 真机 A2L 冒烟夹具（CapabilityReconcilerTests (g)），SHA256 与 a2l-editor samples 副本一致 -->
  <ItemGroup>
    <Content Include="TestData\App_merge_INCA.a2l" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 真实 NM 原因回归数据：权威 DBC + NM_16 trace，SHA256 由测试锁定。 -->
  <ItemGroup>
    <Content Include="TestData\Nm\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- DBC 字节位图演示数据（spec 2026-11-25 §8）。 -->
  <ItemGroup>
    <Content Include="TestData\Dbc\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="E51_PT_CAN-BMS.dbc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>