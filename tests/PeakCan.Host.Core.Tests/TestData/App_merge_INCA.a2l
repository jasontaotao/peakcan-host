    /begin MEASUREMENT B2V_ST1_ChgMode "Charging mode (0x0: Reserved\n      0x1: DC charging\n      0x2: AC charging\n      0x3: Other charging)"
      UBYTE swc_COL_CM_uint8_dash_ 0 0 0 255
      ECU_ADDRESS 0x1FFE7608
      FORMAT "%3.0"
    /end MEASUREMENT

    /begin CHARACTERISTIC B2V_ST1_ChgMode_P "Charging mode (0x0: Reserved\n      0x1: DC charging\n      0x2: AC charging\n      0x3: Other charging)"
      VALUE 0x20019CB2 Scalar_UBYTE 0 swc_COL_CM_uint8_dash_ 0 255
      EXTENDED_LIMITS 0 255
      FORMAT "%3.0"
    /end CHARACTERISTIC

    /begin MEASUREMENT B2V_SingleChgEnergy "Single charge charge (when the charger is online)"
      ULONG swc_COL_CM_uint32_dash_ 0 0 0 65535
      ECU_ADDRESS 0x1FFE60E8
      FORMAT "%10.0"
    /end MEASUREMENT

    /begin CHARACTERISTIC B2V_SingleChgEnergy_P "Single charge charge (when the charger is online)"
      VALUE 0x20019608 Scalar_FLOAT32_IEEE 0 swc_COL_CM_single_kWh 0 65535
      EXTENDED_LIMITS 0 65535
      FORMAT "%8.6"
    /end CHARACTERISTIC

    /begin MEASUREMENT BBC_AcvCellReqSrc "Logical Array for active source cells requested"
      UWORD swc_BatBalnCtl_CM_uint16_dash_ 0 0 0 65535
      ECU_ADDRESS 0x1FFE3700
      FORMAT "%5.0"
      MATRIX_DIM 24 1 1
    /end MEASUREMENT

    /begin MEASUREMENT BBC_AcvCellReqTgt "Logical Array for active target cells"
      UWORD swc_BatBalnCtl_CM_uint16_dash_ 0 0 0 65535
      ECU_ADDRESS 0x1FFE3730
      FORMAT "%5.0"
      MATRIX_DIM 24 1 1
    /end MEASUREMENT

    /begin MEASUREMENT BBC_AcvCellSrcReqdOutp "Logical Array for active source cells requested - value."
      ULONG swc_BatBalnCtl_CM_uint32_dash_ 0 0 0 4294967295
      ECU_ADDRESS 0x1FFE37C0
      FORMAT "%10.0"
      MATRIX_DIM 24 1 1
    /end MEASUREMENT

    /begin CHARACTERISTIC BBC_AcvCellTestSrc_P "Source cell for manual balancing"
      VAL_BLK 0x20017CA8 Scalar_UWORD 0 swc_BatBalnCtl_CM_uint16_dash_  0 65535
      EXTENDED_LIMITS 0 65535
