      FORMAT "%3.0"
    /end MEASUREMENT

    /begin CHARACTERISTIC VehicleBatteryUnusualChargeState_P "VehicleBatteryUnusualChargeState"
      VALUE 0x20019D36 Scalar_UBYTE 0 swc_COL_CM_uint8_dash_ 0 255
      EXTENDED_LIMITS 0 255
      FORMAT "%3.0"
    /end CHARACTERISTIC

    /begin MEASUREMENT VoltageDemand "BCL: Charging Demand Voltage/Discharge Permissible Voltage"
      UWORD swc_COL_CM_uint16_V 0 0 0 65535
      ECU_ADDRESS 0x1FFE7510
      FORMAT "%5.0"
    /end MEASUREMENT

    /begin CHARACTERISTIC VoltageDemand_P "BCL: Charging Demand Voltage/Discharge Permissible Voltage"
      VALUE 0x20019708 Scalar_FLOAT32_IEEE 0 swc_COL_CM_single_V 0 65535
      EXTENDED_LIMITS 0 65535
      FORMAT "%8.6"
    /end CHARACTERISTIC

