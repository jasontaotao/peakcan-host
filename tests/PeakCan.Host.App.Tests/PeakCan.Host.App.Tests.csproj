<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
    <!-- Task 19: collect cobertura coverage report (see Core.Tests for
         the rationale on not setting a hard <Threshold> here). The
         App assembly is the hardest to cover (WPF VMs + AppShell +
         BackgroundService lifecycle code) and the per-VM unit tests
         plus the NetArchTest rules are a stronger safety net than a
         coverage % would be. -->
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutput>../..//coverage/app-coverage</CoverletOutput>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- Task 9: J1939TpSinkAdapterTests needs FakeTimeProvider for the
         offline J1939TpLayer ctor (same package Core.Tests uses). -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PeakCan.Host.App\PeakCan.Host.App.csproj" />
    <ProjectReference Include="..\..\src\PeakCan.Host.Core\PeakCan.Host.Core.csproj" />
    <ProjectReference Include="..\..\src/PeakCan.Host.Infrastructure\PeakCan.Host.Infrastructure.csproj" />
  </ItemGroup>

  <!-- v3.50.2: copy real CAN fixtures to bin/ for integration tests.
       SDK-style csproj auto-includes None items, so explicit copy
       directives are required. Without these, AppContext.BaseDirectory
       cannot resolve tests/.../Fixtures/Can/Logging.asc. -->
  <ItemGroup>
    <None Include="Fixtures/Can/Logging.asc" Link="Fixtures/Can/Logging.asc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Fixtures/Can/pure_electric_v4.6.dbc" Link="Fixtures/Can/pure_electric_v4.6.dbc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 闭环测试 (task: 真实 27930 log → 重组 → chat 工具取多帧):
         从用户 log 截取前 1.3s (5 个完整 RTS/CTS BRM 会话) + 配套 DBC。 -->
    <None Include="Fixtures/Can/gbt27930-charge-hiccup-1.3s.asc" Link="Fixtures/Can/gbt27930-charge-hiccup-1.3s.asc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Fixtures/Can/gbt27930_96_换电.dbc" Link="Fixtures/Can/gbt27930_96_换电.dbc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
