<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PeakCan.Host.Core\PeakCan.Host.Core.csproj" />
    <ProjectReference Include="..\PeakCan.Security\PeakCan.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Peak.PCANBasic.NET" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Sprint 3: HeadlessHostBuilder 迁移到 Infrastructure -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Sprint 19 Inc 8: Polly retry for HilAnalysisService HTTP calls -->
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Windows-only: the DPAPI-backed SecOC key store and the PCAN/ZLG native
         SDKs are Windows-only, so declaring the platform here (instead of a
         platform-neutral net10.0) is accurate and silences CA1416. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PeakCan.Host.Infrastructure.Tests" />
    <!-- Sprint 2: expose HIL classes to Cli project (use assembly name "peakcan-hil") -->
    <InternalsVisibleTo Include="peakcan-hil" />
  </ItemGroup>

  <!-- ZLG 原生运行库：zlgcan.dll 会按 dll_cfg.ini 加载 kerneldlls 中的型号插件，
       必须保留完整目录结构，否则 DLL 可加载但 ZCAN_OpenDevice 仍返回空句柄。 -->
  <ItemGroup>
    <None Include="zlgcan.dll" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="kerneldlls\**" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="zlgcan License.txt" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
