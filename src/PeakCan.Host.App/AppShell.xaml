<Window x:Class="PeakCan.Host.App.AppShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PeakCan.Host.App"
        xmlns:views="clr-namespace:PeakCan.Host.App.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="720" Width="1280">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="打开 DBC(_D)..." Command="{Binding OpenDbcCommand}" />
                <Separator />
                <MenuItem Header="打开会话(_O)..." Command="{Binding OpenSessionCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="保存会话(_S)..." Command="{Binding SaveSessionCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="最近打开(_R)" ItemsSource="{Binding RecentSessionEntries}">
                    <MenuItem.ItemTemplate>
                        <DataTemplate>
                            <MenuItem Header="{Binding Label}"
                                      Command="{Binding DataContext.OpenRecentSessionCommand,
                                                        RelativeSource={RelativeSource AncestorType=Menu}}"
                                      CommandParameter="{Binding Path}" />
                        </DataTemplate>
                    </MenuItem.ItemTemplate>
                </MenuItem>
                <MenuItem Header="清空最近(_C)" Command="{Binding ClearRecentSessionsCommand}" />
                <Separator />
                <MenuItem Header="退出(_X)" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="追踪(_T)" Command="{Binding ShowTraceCommand}" />
                <MenuItem Header="DBC" Command="{Binding ShowDbcCommand}" />
                <MenuItem Header="发送(_S)" Command="{Binding ShowSendCommand}" />
                <MenuItem Header="信号(_G)" Command="{Binding ShowSignalsCommand}" />
                <MenuItem Header="统计(_A)" Command="{Binding ShowStatsCommand}" />
                <MenuItem Header="脚本(_C)" Command="{Binding ShowScriptCommand}" />
                <MenuItem Header="UDS 诊断(_U)" Command="{Binding ShowUdsCommand}" />
                <MenuItem Header="HIL 测试(_I)" Command="{Binding ShowHilCommand}" />
                <MenuItem Header="回放(_P)" Command="{Binding ShowReplayCommand}" />
                <MenuItem Header="追踪查看器(_V)…" Command="{Binding ShowTraceViewerCommand}" />
                <MenuItem Header="ECU 脚本编辑器(_E)" Command="{Binding ShowEcuScriptEditorCommand}" />
                <MenuItem Header="批量发送(_M)..." Command="{Binding OpenMultiFrameCommand}" />
            </MenuItem>
            <!-- P0-4: Window 菜单 —— 列出已打开的二级窗口，点击唤回/打开。
                 ItemsSource 绑 WindowHostService.OpenWindows（WindowEntry），
                 每项 Header=DisplayName + Checked=IsActive + Command=ActivateCommand。 -->
            <MenuItem Header="窗口(_W)" ItemsSource="{Binding WindowHost.OpenWindows}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding DisplayName}" />
                        <Setter Property="IsChecked" Value="{Binding IsActive}" />
                        <Setter Property="Command" Value="{Binding ActivateCommand}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
        </Menu>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <!-- P1-3: 硬件连接配置收敛 —— 探测/通道/波特率/CAN FD 控件移入
                     连接设置面板（⚙ 打开，descriptor 驱动）。工具栏只留入口 + 状态。 -->
                <Button Content="⚙ 设备设置" Command="{Binding OpenConnectionSettingsCommand}" Padding="6,2" />
                <Separator />
                <TextBlock Text="{Binding ChannelList}" VerticalAlignment="Center" Margin="4,0" />
                <Separator />
                <Button Content="连接" Command="{Binding ConnectCommand}" Padding="6,2" />
                <Button Content="断开" Command="{Binding DisconnectCommand}" Padding="6,2" />
                <Separator />
                <ToggleButton Content="● 录制"
                              IsChecked="{Binding IsRecordingPanelOpen, Mode=TwoWay}"
                              Padding="6,2"
                              ToolTip="显示/隐藏录制面板 (Ctrl+R)" />
                <Separator />
                <TextBlock Text="{Binding ConnectionState}" VerticalAlignment="Center" Margin="4,0" Foreground="#1A7F37" FontWeight="SemiBold" />
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding StatusMessage}" />
        </StatusBar>
        <!-- v3.50.1 PATCH-A: Recording panel as a docked Expander. Always
             mounted (cheap), only expanded when the toolbar toggle is on.
             DataContext = RecordingPanel (the RecordViewModel singleton
             wired in via DI). Shared by all tabs — the panel survives
             CurrentView swaps. -->
        <!-- v3.50.1 PATCH-A: Always-mounted Recording Expander. Toolbar
             ToggleButton's IsChecked drives IsRecordingPanelOpen which
             both expands/collapses the expander. The expander is
             always present (collapsed = 0 vertical space); visibility
             and height collapse automatically. -->
        <Expander DockPanel.Dock="Bottom"
                  Header="录制"
                  IsExpanded="{Binding IsRecordingPanelOpen}">
            <views:RecordView DataContext="{Binding RecordingPanel}" />
        </Expander>
        <!-- P1-5: 主内容区 = 主区域 TabControl（追踪/DBC/脚本/回放）+
             右侧常驻实时面板 TabControl（发送/信号/统计）。ContentTemplate 惰性，
             只有选中 tab 才实例化视图（TabSpec 懒工厂）。 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="400" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="300" MinWidth="220" />
            </Grid.ColumnDefinitions>
            <TabControl Grid.Column="0" ItemsSource="{Binding MainTabs}"
                        SelectedIndex="{Binding SelectedMainTabIndex}">
                <TabControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Header}" Margin="6,2" /></DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate><ContentControl Content="{Binding View}" /></DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#CCC" />
            <TabControl Grid.Column="2" ItemsSource="{Binding RightTabs}"
                        SelectedIndex="{Binding SelectedRightTabIndex}">
                <TabControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Header}" Margin="6,2" /></DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate><ContentControl Content="{Binding View}" /></DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
