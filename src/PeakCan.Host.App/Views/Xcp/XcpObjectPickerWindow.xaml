<Window x:Class="PeakCan.Host.App.Views.Xcp.XcpObjectPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PeakCan.Host.App.ViewModels.Xcp"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:XcpObjectPickerViewModel}"
        Title="Add XCP object to watch"
        Width="500" Height="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <!-- S3-T9: dialog for picking XCP objects from the loaded A2L
         contract set (spec §3 批量挑变量，DbcTreePickerWindow 先例).
         Category-grouped tree (MEASUREMENT/CHARACTERISTIC/…) → user
         checks objects + OK → the VM confirms the selection into
         XcpWatchedObjects and the window hands rows back to the caller. -->
    <DockPanel Margin="8">
        <!-- Search box -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="50,0,0,0" />
        </Grid>

        <!-- OK / Cancel buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,4,0,0">
            <TextBlock x:Name="SelectedCountText" VerticalAlignment="Center"
                       Margin="0,0,16,0" Foreground="{StaticResource TextSecondary}" />
            <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True"
                    Click="OnOkClick" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>

        <!-- Tree of A2L categories / objects -->
        <TreeView ItemsSource="{Binding Roots}">
            <!-- Collapse non-matching nodes when the search filter is active. -->
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVisible}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <!-- Object leaves: checkbox + label. Click toggles the
                             VM selection (binding-based IsChecked is unreliable
                             on WPF DataTemplate with this TreeView style —
                             DbcTreePickerWindow precedent). -->
                        <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                  Visibility="{Binding IsLeaf, Converter={StaticResource BoolToVis}}"
                                  Click="OnNodeCheckClick" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   Visibility="{Binding IsCategory, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Name}" Margin="4,0,0,0"
                                   Visibility="{Binding IsLeaf, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</Window>
