<UserControl x:Class="PeakCan.Host.App.Views.Xcp.XcpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:PeakCan.Host.App.Views.Xcp"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1100">
    <!-- S3-T8：XCP 主 tab 视图壳。全部绑定走 XcpViewModel 单一入口；
         卡片 DataTemplate 只消费 T5 评审允许面（值/单位/限值状态/停更态），
         禁止绑定 Contract 完整面（T5 评审 LOW 红线）。 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 连接区（T3 面板绑定）===== -->
        <GroupBox Grid.Row="0" Header="XCP 连接" Padding="6">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding Connection.A2lPath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             Margin="0,0,4,0"
                             ToolTip="A2L 文件路径（D4：Core XcpA2lLoader 单源加载）" />
                    <Button Grid.Column="1" Content="浏览..." Click="OnBrowseA2l" Margin="0,0,4,0" />
                    <!-- T3 评审 LOW-3 移交 + T10：Connected 态禁用重载——重载成功会把状态降回
                         Loaded，归因格存在说谎窗口期。主门已下沉 VM CanExecute（T8 评审移交），
                         本 DataTrigger 保留作视图层双保险（IsEnabled 只覆盖单按钮实例）。 -->
                    <Button Grid.Column="2" Content="加载 A2L"
                            Command="{Binding Connection.LoadA2LCommand}" Margin="0,0,12,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Connection.ConnectionState}" Value="Connected">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- Q2 定案：通道仅来自已连接通道快照（不做独立连接控件）。 -->
                    <ComboBox Grid.Column="3" Width="180"
                              ItemsSource="{Binding Connection.Channels}"
                              SelectedItem="{Binding Connection.SelectedChannel}"
                              DisplayMemberPath="Name"
                              ToolTip="选择已连接通道" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0">
                        <!-- D6：Start = 对账 + Plan + 轮转 + 轮询；拒绝明细进状态区。 -->
                        <!-- T11（T9 选择器接线）：A2L 未加载态禁用（Loaded/Connected 可用）。
                             入口构造 XcpObjectPickerViewModel(LoadedResult.Contracts, traceSession)，
                             OK 后 ConfirmedRows 逐行回填卡片（code-behind OnPickObjects）。 -->
                        <Button Content="选择对象..." Click="OnPickObjects" MinWidth="72" Margin="0,0,4,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Connection.ConnectionState}" Value="Disconnected">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Start" Command="{Binding Acquisition.StartCommand}"
                                MinWidth="72" Margin="0,0,4,0" />
                        <Button Content="Stop" Command="{Binding Acquisition.StopCommand}" MinWidth="72" />
                    </StackPanel>
                </Grid>
                <!-- 状态区：ValidationNote / 对账明细 / 启停事件（人读文本）。 -->
                <ItemsControl ItemsSource="{Binding Connection.StatusLines}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Acquisition.StatusLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </GroupBox>

        <!-- ===== S4-T5：MDF 记录控件带（spec D5）：开始/停止 + 目录 + 状态行 ===== -->
        <GroupBox Grid.Row="1" Header="MDF 记录" Padding="6" Margin="0,8,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                        <Button Content="开始记录" Command="{Binding Record.StartRecordCommand}"
                                MinWidth="72" Margin="0,0,4,0" />
                        <Button Content="停止记录" Command="{Binding Record.StopRecordCommand}" MinWidth="72" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Width="280"
                             Text="{Binding Record.RecordDirectory, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Margin="0,0,4,0"
                             ToolTip="记录文件目录（spec D5：默认会话目录，可改选）" />
                    <Button Grid.Column="2" Content="浏览..." Click="OnBrowseRecordDirectory"
                            HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="Gray">
                        <Run Text="已写 " /><Run Text="{Binding Record.WrittenCount, Mode=OneWay}" />
                        <Run Text=" 条，丢 " /><Run Text="{Binding Record.DroppedCount, Mode=OneWay}" />
                        <Run Text=" 条，时长 " /><Run Text="{Binding Record.DurationText, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
                <!-- S4-T6：触发记录控件（spec D6：常驻环 + 独立文件产物；窗口 1–60，Q2 硬顶）。 -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="触发记录" Command="{Binding Record.TriggerRecordCommand}"
                            MinWidth="72" Margin="0,0,8,0"
                            ToolTip="触发捕获：环（触发前 N 秒）+ 后续流落独立 xcp_trigger 文件" />
                    <TextBlock Text="前 " VerticalAlignment="Center" />
                    <TextBox Width="36" Text="{Binding Record.PreTriggerSecondsText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Margin="0,0,2,0"
                             ToolTip="触发前窗口秒数（1–60）" />
                    <TextBlock Text=" s，后 " VerticalAlignment="Center" />
                    <TextBox Width="36" Text="{Binding Record.PostTriggerSecondsText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Margin="0,0,2,0"
                             ToolTip="触发后窗口秒数（1–60）" />
                    <TextBlock Text=" s（1–60，默认 10）" VerticalAlignment="Center" Foreground="Gray" />
                </StackPanel>
                <TextBlock Text="{Binding Record.TriggerStatusText}" Margin="0,4,0,0"
                           Foreground="Gray" TextTrimming="CharacterEllipsis"
                           ToolTip="触发捕获文件：触发中/完成后显示" />
                <TextBlock Text="{Binding Record.CaptureFilePath, StringFormat='触发文件：{0}'}"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Foreground="Gray" />
                <TextBlock Text="{Binding Record.FilePath, StringFormat='文件：{0}'}"
                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Foreground="Gray" />
                <TextBlock Text="{Binding Record.StatusText}" Margin="0,4,0,0" />
                <!-- 故障红字（spec D5：写盘故障状态区红字，采集不受影响）。 -->
                <TextBlock Text="{Binding Record.FaultText}" Foreground="Red" TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <!-- ===== S5-T4：标定写回控件带（spec D5）：参数集导出/下发 + 行内写值 ===== -->
        <GroupBox Grid.Row="2" Header="标定写回" Padding="6" Margin="0,8,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="360"
                             Text="{Binding Writeback.ParameterSetPath, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                             VerticalContentAlignment="Center" Margin="0,0,4,0"
                             ToolTip="参数集文件路径（.json，明文可 diff；导出/下发共用）" />
                    <Button Content="导出参数集" Command="{Binding Writeback.ExportParameterSetCommand}"
                            MinWidth="80" Margin="0,0,4,0"
                            ToolTip="关注集 CHARACTERISTIC 当前数值 → 明文 JSON（绑定当前 A2L 指纹）" />
                    <Button Content="下发参数集" Command="{Binding Writeback.ApplyParameterSetCommand}"
                            MinWidth="80" Margin="0,0,4,0"
                            ToolTip="加载 → 指纹校验 → 差异对账 → 只写差异项 → 结果单（D3）" />
                    <TextBlock Text="{Binding Writeback.StatusText}" VerticalAlignment="Center"
                               Foreground="Gray" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Text="行内写值：CHARACTERISTIC 卡片内输入物理值点[写值]；写入后自动回读校验（D4）。未采集时写值禁用。"
                           Foreground="Gray" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>
        </GroupBox>

        <!-- ===== 主区：左卡片总览（显示集）/ 右采集覆盖清单 + 归因合并表 ===== -->
        <!-- S6-T3（D7）：主区改 TabControl——实时采集（原归因合并表区迁移）/ 回放。 -->
        <TabControl Grid.Row="3" Margin="0,8,0,0">
            <TabItem Header="实时采集">
                        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- 卡片格（S1 §5.5：第一屏常驻可扫；停更灰显由 IsStale 驱动）。 -->
            <GroupBox Grid.Column="0" Header="关注集卡片" Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Cards.Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 停更灰显（S1 §5.5）：IsStale 时整卡降不透明度。 -->
                                <Border Width="150" Margin="4" Padding="8" CornerRadius="4"
                                        BorderThickness="1" BorderBrush="Gray">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStale}" Value="True">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" FontWeight="SemiBold" />
                                        <!-- 越限变色（S1 §5.5）：判定只读合同解析期限值字段。 -->
                                        <TextBlock Text="{Binding DisplayValue}" FontSize="20">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LimitState}" Value="OutOfLimit">
                                                            <Setter Property="Foreground" Value="Red" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LimitState}" Value="OutOfExtendedLimit">
                                                            <Setter Property="Foreground" Value="DarkOrange" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Unit}" Foreground="Gray" />
                                        <TextBlock Text="{Binding StaleDuration}" FontSize="11" Foreground="Gray" />
                                        <!-- S5-T4（D5）：行内写值（CHARACTERISTIC 卡片；未接线/非标定时按钮禁用）。 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                    Visibility="{Binding CanWrite, Converter={StaticResource BoolToVisibility}}">
                                            <TextBox Width="70"
                                                     Text="{Binding WriteValueText, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                     VerticalContentAlignment="Center" Margin="0,0,2,0"
                                                     ToolTip="目标物理值（写后自动回读校验）" />
                                            <Button Content="写值" Command="{Binding WriteValueCommand}"
                                                    MinWidth="36" Padding="2,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding LastWriteStatus}" FontSize="10"
                                                   Foreground="DarkOrange" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="LightGray" />

            <DockPanel Grid.Column="2">
                <!-- 采集覆盖清单（D6：Covered/PollingCause/MissingCause 三列直读）。 -->
                <GroupBox DockPanel.Dock="Top" Header="采集覆盖清单" Padding="4" MaxHeight="220">
                    <DataGrid ItemsSource="{Binding Acquisition.CoverageEntries}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="对象" Binding="{Binding ObjectName}" Width="*" />
                            <DataGridCheckBoxColumn Header="覆盖" Binding="{Binding Covered}" Width="Auto" />
                            <DataGridTextColumn Header="轮询原因" Binding="{Binding PollingCause}" Width="Auto" />
                            <DataGridTextColumn Header="缺失原因" Binding="{Binding MissingCause}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
                <!-- 归因合并表（D5：逐格计数 + 最近明细）。 -->
                <GroupBox Header="归因合并表" Padding="4" Margin="0,8,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Attribution.Cells}" Margin="2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,1" Padding="6,3" BorderThickness="0,0,0,1" BorderBrush="LightGray">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="Gray" />
                                            </Grid>
                                            <TextBlock Text="{Binding LastDetail}" TextWrapping="Wrap"
                                                       FontSize="11" Foreground="Gray" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </GroupBox>
            </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="回放">
                <local:XcpReplayView DataContext="{Binding Replay}" />
            </TabItem>
            <TabItem Header="MAP 可视化">
                <local:XcpMapView DataContext="{Binding Map}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
