<UserControl x:Class="PeakCan.Host.App.Views.Xcp.XcpMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <!-- S6-T4：MAP 只读可视化页（spec D4）。heatmap 渲染走 ScottPlot；无写入口（S1 钉）。
         无连接时离线兜底（仅结构）；鼠标悬停读格值。 -->
    <DockPanel Margin="4">
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="MAP 对象：" VerticalAlignment="Center" />
                <ComboBox Width="260" ItemsSource="{Binding Maps}"
                          SelectedItem="{Binding SelectedMap}" Margin="4,0" />
                <Button Content="读取" Padding="10,2" Command="{Binding ReadCommand}" />
                <ProgressBar Width="60" Height="14" Margin="8,0,0,0" IsIndeterminate="{Binding IsBusy}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" Foreground="Gray" Margin="0,2,0,0" />
        </StackPanel>

        <TextBlock x:Name="ReadoutText" DockPanel.Dock="Bottom" Margin="0,4,0,0"
                   Foreground="DarkSlateGray" Text="（悬停读取格值）" />

        <scott:WpfPlot x:Name="PlotControl" MouseMove="OnPlotMouseMove" Margin="0,8,0,0" />
    </DockPanel>
</UserControl>
