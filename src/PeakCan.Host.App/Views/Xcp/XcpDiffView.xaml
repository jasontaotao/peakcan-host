<UserControl x:Class="PeakCan.Host.App.Views.Xcp.XcpDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <!-- S6-T5：参数集 diff 页（spec D5）。只读可视化：越限行标红；
         选中行定位 XcpView 对象卡片；应用走 S5 既有 apply 链路，本页无写入口。 -->
    <DockPanel Margin="4">
        <StackPanel DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="基线：" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding BaselinePath, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Margin="0,0,4,0"
                         ToolTip="基线参数集 JSON（S5 导出格式）" />
                <Button Grid.Column="2" Content="浏览..." Click="OnBrowseBaseline" Margin="0,0,12,0" />
                <TextBlock Grid.Column="3" Text="目标：" VerticalAlignment="Center" />
                <TextBox Grid.Column="4" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Margin="0,0,4,0"
                         ToolTip="目标参数集 JSON（S5 导出格式）" />
                <Button Grid.Column="5" Content="浏览..." Click="OnBrowseTarget" Margin="0,0,12,0" />
                <Button Grid.Column="6" Content="计算 diff" Padding="10,2"
                        Command="{Binding LoadAndDiffCommand}" Grid.ColumnSpan="2" />
            </Grid>
            <TextBlock Text="{Binding StatusText}" Foreground="Gray" Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="定位对象卡片" Padding="10,2"
                    Command="{Binding LocateCommand}"
                    CommandParameter="{Binding SelectedRow}" />
            <ProgressBar Width="60" Height="14" Margin="8,0,0,0" IsIndeterminate="{Binding IsBusy}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Margin="0,8,0,0">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOutOfRange}" Value="True">
                            <Setter Property="Background" Value="#FFFFE0E0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="对象" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="种类" Binding="{Binding Kind}" Width="70" />
                <DataGridTextColumn Header="原值" Binding="{Binding OldValue}" Width="*" />
                <DataGridTextColumn Header="新值" Binding="{Binding NewValue}" Width="*" />
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60" />
                <DataGridTextColumn Header="下限" Binding="{Binding LowerLimit}" Width="70" />
                <DataGridTextColumn Header="上限" Binding="{Binding UpperLimit}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
