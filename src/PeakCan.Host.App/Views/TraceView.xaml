<UserControl x:Class="PeakCan.Host.App.Views.TraceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PeakCan.Host.App.ViewModels"
             xmlns:controls="clr-namespace:PeakCan.Host.App.Views.Controls"
             xmlns:core="clr-namespace:PeakCan.Host.Core.J1939;assembly=PeakCan.Host.Core"
             d:DataContext="{d:DesignInstance Type=vm:TraceViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <DockPanel LastChildFill="False">
        <!-- 工具栏：只留高频动作。过滤条件统一走下面的条件条（+ 条件 / 行右键），
             批量输入仍在「高级过滤」里（默认折叠）。 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,4">
            <Button Content="清空帧" Command="{Binding ClearCommand}" Padding="8,2" Margin="0,0,4,0"
                    ToolTip="清空已采集的帧 (Ctrl+L)" />
            <Button Content="导出 CSV" Command="{Binding ExportCsvCommand}" Padding="8,2" Margin="0,0,4,0"
                    ToolTip="导出当前可见行 (Ctrl+E)" />
            <Button Content="导出全部" Command="{Binding ExportAllCsvCommand}" Padding="8,2" Margin="0,0,12,0" />
            <CheckBox Content="暂停" IsChecked="{Binding IsPaused}" VerticalAlignment="Center" Margin="0,0,12,0"
                      ToolTip="暂停 / 继续采集 (Ctrl+P)" />
            <CheckBox Content="仅错误帧" IsChecked="{Binding ShowErrorsOnly}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="清除过滤" Command="{Binding ClearFiltersCommand}" Padding="8,2" Margin="0,0,4,0" />
            <!-- P0-2：清除行右键/条件构建器产生的 ID 排除（不影响其他过滤条件）。 -->
            <Button Content="清除排除" Command="{Binding ClearExcludedIdsCommand}" Padding="8,2"
                    ToolTip="清除右键“排除这个 ID”与条件构建器产生的排除集合" />
        </StackPanel>

        <!-- 高级过滤：批量粘贴 ID / PGN 的熟练路径，默认折叠。
             用 WrapPanel 而不是横向 StackPanel——后者给子元素无限宽度，窗口变窄也不换行。 -->
        <Expander x:Name="AdvancedFilterExpander" DockPanel.Dock="Top" IsExpanded="False"
                  Margin="4,0,4,4" HorizontalAlignment="Stretch">
            <Expander.Header>
                <TextBlock Text="高级过滤（批量输入）" FontWeight="SemiBold" />
            </Expander.Header>
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="ID列表" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Text="{Binding IdListText, UpdateSourceTrigger=PropertyChanged}" Width="90" VerticalAlignment="Center" ToolTip="ID allow-list：无前缀=十进制，0x=hex（逗号/空格分隔）" />

                    <TextBlock Text="PGN(hex)" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <TextBox Text="{Binding PgnText, UpdateSourceTrigger=PropertyChanged}" Width="70" VerticalAlignment="Center" ToolTip="PGN 列表：hex，0x 可选（≤0x3FFFF）" />

                    <TextBlock Text="SA" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <TextBox Text="{Binding SaText, UpdateSourceTrigger=PropertyChanged}" Width="40" VerticalAlignment="Center" ToolTip="源地址：单 hex 字节（空=不过滤）" />

                    <TextBlock Text="DA" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <TextBox Text="{Binding DaText, UpdateSourceTrigger=PropertyChanged}" Width="40" VerticalAlignment="Center" ToolTip="目标地址：单 hex 字节，仅 PDU1 可匹配（空=不过滤）" />

                    <TextBlock Text="DBC消息" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <ComboBox Width="110"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              Text="{Binding DbcMessageName, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding DbcMessageNames}"
                              VerticalAlignment="Center" ToolTip="DBC 消息名符号（可编辑，提交时解析并并入 ID allow-list）" />

                    <TextBlock Text="通道" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <ComboBox MinWidth="90"
                              ItemsSource="{Binding DataContext.ChannelConnections, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Channel.Id"
                              SelectedValue="{Binding ChannelFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="留空=显示全部通道" />

                    <CheckBox Content="排除（整体取反）" IsChecked="{Binding ExcludeMatch}" VerticalAlignment="Center" Margin="8,0,0,0"
                              ToolTip="整体取反（黑名单语义）" />
                </WrapPanel>
                <WrapPanel Margin="0,4,0,0">
                    <TextBlock Text="载荷" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="字节模式过滤：(payload[offset] &amp; mask) == value；三字段全空=无条件，部分填=错误" />
                    <TextBlock Text="偏移" VerticalAlignment="Center" />
                    <TextBox Text="{Binding PayloadOffsetText, UpdateSourceTrigger=PropertyChanged}" Width="40" VerticalAlignment="Center" Margin="2,0,0,0" />
                    <TextBlock Text="掩码(hex)" VerticalAlignment="Center" Margin="6,0,2,0" />
                    <TextBox Text="{Binding PayloadMaskHex, UpdateSourceTrigger=PropertyChanged}" Width="40" VerticalAlignment="Center" />
                    <TextBlock Text="值(hex)" VerticalAlignment="Center" Margin="6,0,2,0" />
                    <TextBox Text="{Binding PayloadValueHex, UpdateSourceTrigger=PropertyChanged}" Width="40" VerticalAlignment="Center" />
                </WrapPanel>
            </StackPanel>
        </Expander>

        <!-- P0-3：过滤条件 chip 条 —— 已生效条件可见、可单条移除（批量条件不再难追踪） -->
        <Border DockPanel.Dock="Top" Margin="4,0,4,6" Padding="6,4"
                Background="{StaticResource CanvasBg}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="3">
            <!-- DockPanel 给 ItemsControl 有限宽度，WrapPanel 才会真正换行
                 （横向 StackPanel 会给子元素无限宽度，chip 永不折行）。 -->
            <DockPanel>
                <!-- 提示放前面并 Dock=Left：DockPanel 的 LastChildFill 会填满最后一个
                     子元素，因此 ItemsControl 必须是最后一个（获得剩余有限宽度）。 -->
                <!-- M1：过滤文本非法时 chip 只是"文本投影"，_activeSpec 冻结在上一有效值；
                     显式标注"未生效"，避免用户以为删 chip 会改变表格。 -->
                <TextBlock DockPanel.Dock="Left"
                           Text="过滤未生效（存在非法输入）"
                           Foreground="{StaticResource Error}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="4,0,10,0"
                           Visibility="{Binding FilterErrorText, Converter={StaticResource NullToVisibilityConverter}}" />
                <TextBlock DockPanel.Dock="Left"
                           Text="无过滤条件 —— 点右侧“+ 条件”，或右键表格行快速只看 / 排除 / 高亮"
                           FontStyle="Italic" VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterChips.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- P1：条件构建器入口。必须排在 ScrollViewer 之前——DockPanel 的
                     LastChildFill 会把剩余宽度给最后一个子元素。 -->
                <Button x:Name="AddConditionButton" DockPanel.Dock="Right"
                        Content="+ 条件" Padding="8,2" Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding OpenFilterBuilderCommand}"
                        ToolTip="按字段添加过滤条件（ID / PGN / SA / DA / DBC 消息 / Payload…）" />
                <Popup DockPanel.Dock="Right"
                       PlacementTarget="{Binding ElementName=AddConditionButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       IsOpen="{Binding IsBuilderOpen, Mode=TwoWay}">
                    <Border Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="4" Padding="10" Margin="0,4,0,0" MinWidth="360">
                        <StackPanel>
                            <!-- 关闭交给 ✕ 与 StaysOpen=False（点外部/Esc），按钮只负责"打开"：
                                 Toggle 与 StaysOpen=False 会互相抢鼠标捕获，导致按钮关不掉。 -->
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseFilterBuilderCommand}"
                                        Background="Transparent" BorderThickness="0" Padding="6,0"
                                        ToolTip="关闭" />
                                <TextBlock Text="添加过滤条件" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding FilterBuilderFields}"
                                      SelectedItem="{Binding SelectedBuilderField}"
                                      DisplayMemberPath="Label" />
                            <TextBox Text="{Binding BuilderValue, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding BuilderValueToolTip}"
                                     Margin="0,6,0,0"
                                     Visibility="{Binding IsBuilderValueVisible, Converter={StaticResource BoolToVis}}" />
                            <ComboBox ItemsSource="{Binding DbcMessageNames}"
                                      SelectedItem="{Binding SelectedBuilderChoice}"
                                      Margin="0,6,0,0"
                                      Visibility="{Binding IsBuilderChoiceVisible, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding BuilderValueToolTip}"
                                       Foreground="{StaticResource TextDisabled}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding IsBuilderFlagVisible, Converter={StaticResource BoolToVis}}" />
                            <WrapPanel Margin="0,6,0,0"
                                       Visibility="{Binding IsBuilderPayloadVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="偏移" VerticalAlignment="Center" />
                                <TextBox Text="{Binding BuilderPayloadOffset, UpdateSourceTrigger=PropertyChanged}" Width="44" Margin="2,0,8,0" />
                                <TextBlock Text="掩码(hex)" VerticalAlignment="Center" />
                                <TextBox Text="{Binding BuilderPayloadMask, UpdateSourceTrigger=PropertyChanged}" Width="44" Margin="2,0,8,0" />
                                <TextBlock Text="值(hex)" VerticalAlignment="Center" />
                                <TextBox Text="{Binding BuilderPayloadValue, UpdateSourceTrigger=PropertyChanged}" Width="44" Margin="2,0,0,0" />
                            </WrapPanel>
                            <TextBlock Text="{Binding BuilderError}" Foreground="{StaticResource Error}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding BuilderError, Converter={StaticResource NullToVisibilityConverter}}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="添加" Command="{Binding AddFilterConditionCommand}" Padding="14,3" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="64">
                <ItemsControl ItemsSource="{Binding FilterChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,6,2" Padding="8,2,2,2" CornerRadius="10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource RowAlternate}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:FilterChipKinds.ExcludeMode}">
                                                <Setter Property="BorderBrush" Value="{StaticResource Error}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:FilterChipKinds.ExcludedId}">
                                                <Setter Property="BorderBrush" Value="{StaticResource Error}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:FilterChipKinds.ErrorsOnly}">
                                                <Setter Property="Background" Value="{StaticResource WarnBg}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource WarnBorder}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:FilterChipKinds.ExcludeMode}">
                                                        <Setter Property="Foreground" Value="{StaticResource Error}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:FilterChipKinds.ExcludedId}">
                                                        <Setter Property="Foreground" Value="{StaticResource Error}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:FilterChipKinds.ErrorsOnly}">
                                                        <Setter Property="Foreground" Value="{StaticResource WarnText}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Command="{Binding RemoveCommand}" Content="✕"
                                            Padding="6,0" Margin="6,0,0,0"
                                            Background="Transparent" BorderThickness="0"
                                            ToolTip="移除该过滤条件"
                                            AutomationProperties.Name="{Binding Label, StringFormat='移除 {0}'}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 状态行：过滤错误 / 显示计数 / MaxRows。过滤输入搬到「高级过滤」后，
             错误与计数必须留在常驻位置，否则折叠时看不到"过滤未生效"。 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,4,4">
            <TextBlock Text="{Binding FilterErrorText}" Foreground="{StaticResource Error}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource TextSecondary}" />
            <TextBlock Text="上限" VerticalAlignment="Center" Margin="16,0,2,0" Foreground="{StaticResource TextSecondary}" />
            <TextBox Text="{Binding MaxRowsText, UpdateSourceTrigger=PropertyChanged}" Width="50" VerticalAlignment="Center" ToolTip="最大行数 [100, 50000]" />
            <TextBlock Text="行" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
            <TextBlock Text="{Binding MaxRowsErrorText}" Foreground="{StaticResource Error}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <!-- 工具栏2：高亮（spec §6） -->
        <StackPanel DockPanel.Dock="Top" Margin="4,0,4,4">
            <Expander HorizontalAlignment="Left">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="高亮规则" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HighlightSummaryText}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,4,0,0">
                    <DataGrid ItemsSource="{Binding HighlightRules}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              MaxHeight="140"
                              AlternatingRowBackground="{StaticResource RowAlternate}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                            <DataGridTemplateColumn Header="颜色" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedIndex="{Binding ColorIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBoxItem Content="1" />
                                            <ComboBoxItem Content="2" />
                                            <ComboBoxItem Content="3" />
                                            <ComboBoxItem Content="4" />
                                            <ComboBoxItem Content="5" />
                                            <ComboBoxItem Content="6" />
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ID列表" Binding="{Binding IdListText, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                            <DataGridTextColumn Header="PGN(hex)" Binding="{Binding PgnListText, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                            <DataGridTemplateColumn Header="删除" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕"
                                                Padding="4,0"
                                                HorizontalAlignment="Center"
                                                Command="{Binding DataContext.RemoveHighlightRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="+ 添加" Command="{Binding AddHighlightRuleCommand}" Padding="8,2" />
                        <TextBlock Text="两文本全空 = 匹配全部（兜底规则放最后）" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>

        <!-- DataGrid：ItemsSource=EntriesView（视图层过滤，非破坏性）。
             外面套一层 Grid 是为了让空态面板与表格同格叠放（后声明的面板画在上层）。 -->
        <Grid DockPanel.Dock="Top">
        <DataGrid
              x:Name="TraceGrid"
              ItemsSource="{Binding EntriesView}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              EnableRowVirtualization="True"
              EnableColumnVirtualization="True"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              VirtualizingPanel.ScrollUnit="Pixel"
              ScrollViewer.CanContentScroll="True"
              ScrollViewer.ScrollChanged="OnScrollChanged"
              AlternatingRowBackground="{StaticResource RowAlternate}"
              PreviewMouseRightButtonDown="OnGridPreviewMouseRightButtonDown"
              ContextMenuOpening="OnGridContextMenuOpening">
        <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
                <!-- P0-1：所有行统一预留 3px 左边框（透明），错误行只换颜色，
                     避免逐行改动 BorderThickness 造成内容位移。 -->
                <Setter Property="BorderThickness" Value="3,0,0,0" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsError}" Value="True">
                        <Setter Property="Background" Value="{StaticResource FrameBgError}" />
                        <!-- P0-1：高亮触发器只改 Background，红条不可被覆盖。 -->
                        <Setter Property="BorderBrush" Value="{StaticResource Error}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFd}" Value="True">
                        <Setter Property="Background" Value="{StaticResource FrameBgFd}" />
                    </DataTrigger>
                    <!-- M2: sim 帧灰显（spec §4.3 + §6.5 FrameSource.Environment） -->
                    <DataTrigger Binding="{Binding IsSim}" Value="True">
                        <Setter Property="Background" Value="{StaticResource FrameBgSim}" />
                        <Setter Property="Foreground" Value="{StaticResource FrameFgSim}" />
                        <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                    <!-- 高亮规则色索引 0..5，排最后（高亮盖过 Error/Fd 底色） -->
                    <DataTrigger Binding="{Binding HighlightColorIndex}" Value="0">
                        <Setter Property="Background" Value="{StaticResource FrameBgHighlight}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HighlightColorIndex}" Value="1">
                        <Setter Property="Background" Value="{StaticResource TraceHl1}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HighlightColorIndex}" Value="2">
                        <Setter Property="Background" Value="{StaticResource TraceHl2}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HighlightColorIndex}" Value="3">
                        <Setter Property="Background" Value="{StaticResource TraceHl3}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HighlightColorIndex}" Value="4">
                        <Setter Property="Background" Value="{StaticResource TraceHl4}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HighlightColorIndex}" Value="5">
                        <Setter Property="Background" Value="{StaticResource TraceHl5}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DataGrid.RowStyle>
        <!-- P0-2：行右键菜单。ContextMenu 不在 DataGrid 可视树内，命令与参数
             一律经 PlacementTarget 取；右键先由 code-behind 选中指针下的行。 -->
        <DataGrid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="只看这个 ID"
                          Command="{Binding PlacementTarget.DataContext.ShowOnlyThisIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="排除这个 ID"
                          Command="{Binding PlacementTarget.DataContext.ExcludeThisIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="高亮这个 ID"
                          Command="{Binding PlacementTarget.DataContext.HighlightThisIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <Separator />
                <MenuItem Header="复制 ID / 数据" Click="OnCopyIdAndData" />
            </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
            <DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" Width="120" />
            <DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="60" />
            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100" />
            <DataGridTextColumn Header="类型" Binding="{Binding FrameType}" Width="50" />
            <DataGridTemplateColumn Header="Sim" Width="36">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="sim" FontStyle="Italic" Foreground="{StaticResource FrameFgSim}"
                                   Visibility="{Binding IsSim, Converter={StaticResource BoolToVis}}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="50" />
            <!-- F1-4: SecOC verdict column restored (2026-09-16 plan). The App
                 now wires SecOcChannel into its connect path and assigns
                 TraceViewModel.SecOcBadgeResolver (ViewModelsBatch2Flow), so the
                 badge renders ✓ (green) / ✗ reason (red) / 未保护 (gray) /
                 离线不验 (gray). -->
            <DataGridTemplateColumn Header="SecOC" Width="90">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding SecOcBadge.Text}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SecOcBadge.Kind}" Value="{x:Static vm:SecOcBadgeKind.Accepted}">
                                            <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SecOcBadge.Kind}" Value="{x:Static vm:SecOcBadgeKind.Rejected}">
                                            <Setter Property="Foreground" Value="{StaticResource Error}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SecOcBadge.Kind}" Value="{x:Static vm:SecOcBadgeKind.Unprotected}">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SecOcBadge.Kind}" Value="{x:Static vm:SecOcBadgeKind.Offline}">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="数据" Binding="{Binding DataHex}" Width="*" />
            <DataGridTextColumn Header="解码" Binding="{Binding Decoded}" Width="200" />
        </DataGrid.Columns>
        </DataGrid>

            <!-- P0 空态一：一帧都没有。这里没有可在本页完成的逆操作，
                 所以只给说明不给按钮（连接动作在顶部工具栏）。 -->
            <controls:EmptyStatePanel Title="还没有收到帧"
                                      Description="连接通道后，总线上的报文会实时出现在这里。"
                                      AutomationProperties.Name="空态：还没有收到帧">
                <controls:EmptyStatePanel.Style>
                    <Style TargetType="controls:EmptyStatePanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTraceEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:EmptyStatePanel.Style>
            </controls:EmptyStatePanel>

            <!-- P0 空态二：有帧但被过滤条件全部排除。必须给"清除过滤"这个出路，
                 否则用户只能自己回想改了哪些条件。 -->
            <controls:EmptyStatePanel Title="过滤条件把帧全挡掉了"
                                      Description="{Binding Entries.Count, StringFormat='已收到 {0} 条帧，全部被当前过滤条件排除。'}"
                                      ActionText="清除过滤"
                                      ActionCommand="{Binding ClearFiltersCommand}"
                                      AutomationProperties.Name="空态：过滤条件把帧全挡掉了">
                <controls:EmptyStatePanel.Style>
                    <Style TargetType="controls:EmptyStatePanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <!-- 判据已包含"收到过帧"（Entries.Count > 0），
                                 一帧都没有时自然让位给上一条空态。 -->
                            <DataTrigger Binding="{Binding IsTraceFilteredEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:EmptyStatePanel.Style>
            </controls:EmptyStatePanel>
        </Grid>

        <!-- 底栏：报文统计（spec §6，可折叠）——保持原最底位置（DockPanel 先声明的
             Dock=Bottom 子元素贴底边，J1939 面板列在它后面 → 位于其上方）。 -->
        <Expander DockPanel.Dock="Bottom"
                  Margin="4,4,4,4"
                  IsExpanded="{Binding StatsExpanded, Mode=TwoWay}">
            <Expander.Header>
                <TextBlock Text="报文统计（Top-20）" FontWeight="SemiBold" />
            </Expander.Header>
            <Grid>
                <DataGrid ItemsSource="{Binding StatsRows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          MaxHeight="180">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdHex}" Width="100" />
                        <DataGridTextColumn Header="DBC 消息" Binding="{Binding DbcName}" Width="140" />
                        <DataGridTextColumn Header="计数" Binding="{Binding Count}" Width="70" />
                        <DataGridTextColumn Header="占比" Binding="{Binding Percent, StringFormat={}{0:F1}%}" Width="80" />
                        <DataGridTemplateColumn Header="设为过滤" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="设为过滤"
                                            Padding="4,0"
                                            HorizontalAlignment="Center"
                                            Command="{Binding DataContext.SetFilterToIdCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <!-- P0 空态：统计要等帧到了才有内容，空着时说明它在等什么。 -->
                <controls:EmptyStatePanel Title="还没有 ID 统计"
                                          Description="收到帧后，这里会列出出现次数最多的 20 个 ID。"
                                          AutomationProperties.Name="空态：还没有 ID 统计">
                    <controls:EmptyStatePanel.Style>
                        <Style TargetType="controls:EmptyStatePanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatsRows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:EmptyStatePanel.Style>
                </controls:EmptyStatePanel>
            </Grid>
        </Expander>

        <!-- J1939TP 会话事件：在线 SessionEvent（丢包/超时/被取代/驱逐）实时面板。
             与主帧表格独立（事件无 CAN ID/通道/帧时间戳），不流过帧过滤/计数/解码。 -->
        <Expander DockPanel.Dock="Bottom"
                  Margin="4,4,4,4"
                  IsExpanded="{Binding J1939EventsExpanded, Mode=TwoWay}">
            <Expander.Header>
                <TextBlock Text="J1939TP 会话事件" FontWeight="SemiBold" />
            </Expander.Header>
            <Grid>
                <DataGrid ItemsSource="{Binding J1939SessionEvents}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          MaxHeight="180">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <!-- PacketLoss/Timeout 视为会话致命 → 错误帧底色；Superseded 中性告警；Evicted 容量事件最弱 -->
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:SessionEventKind.PacketLoss}">
                                    <Setter Property="Background" Value="{StaticResource FrameBgError}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:SessionEventKind.Timeout}">
                                    <Setter Property="Background" Value="{StaticResource FrameBgError}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:SessionEventKind.Superseded}">
                                    <Setter Property="Background" Value="{StaticResource TraceHl3}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:SessionEventKind.Evicted}">
                                    <Setter Property="Background" Value="{StaticResource RowAlternate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- 时刻 = bus 秒（F3，与主网格/离线面板同基准）；通道 = 触发帧所属通道 -->
                        <DataGridTextColumn Header="时刻" Binding="{Binding TimestampSec, StringFormat=F3}" Width="90" />
                        <DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="60" />
                        <DataGridTextColumn Header="事件" Binding="{Binding Kind}" Width="90" />
                        <DataGridTextColumn Header="SA" Binding="{Binding Sa, StringFormat=0x{0:X2}}" Width="50" />
                        <DataGridTextColumn Header="DA" Binding="{Binding Da, StringFormat=0x{0:X2}}" Width="50" />
                        <DataGridTextColumn Header="PGN" Binding="{Binding Pgn, StringFormat=0x{0:X4}}" Width="80" />
                        <DataGridTextColumn Header="模式" Binding="{Binding Mode}" Width="70" />
                        <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <!-- P0 空态：J1939TP 会话事件是异常触发型，空着是常态，别让用户以为坏了。 -->
                <controls:EmptyStatePanel Title="还没有 J1939 会话事件"
                                          Description="只有 J1939TP 会话出现丢包、超时、被取代或驱逐时，事件才会出现在这里。"
                                          AutomationProperties.Name="空态：还没有 J1939 会话事件">
                    <controls:EmptyStatePanel.Style>
                        <Style TargetType="controls:EmptyStatePanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding J1939SessionEvents.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:EmptyStatePanel.Style>
                </controls:EmptyStatePanel>
            </Grid>
        </Expander>
    </DockPanel>
</UserControl>

