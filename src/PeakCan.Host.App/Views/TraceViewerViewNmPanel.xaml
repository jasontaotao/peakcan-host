<UserControl x:Class="PeakCan.Host.App.Views.TraceViewerViewNmPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PeakCan.Host.App.Converters"
             xmlns:cconv="clr-namespace:PeakCan.Host.App.Composition.Converters"
             xmlns:vm="clr-namespace:PeakCan.Host.App.ViewModels">
    <UserControl.Resources>
        <conv:NmChipBrushConverter x:Key="NmChipBrush" />
        <conv:NmSegmentBrushConverter x:Key="NmSegmentBrush" />
        <conv:NmEventShapeConverter x:Key="NmEventShape" />
        <conv:NmTimelinePixelXConverter x:Key="NmPixelX" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- 面板内定义的转换器：面板必须能在不加载 App.xaml 的情况下单独实例化
             （面板级 XAML 冒烟测试就这么做）。依赖全局资源会让它抛 XamlParseException。 -->
        <cconv:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVis" />
        <cconv:CountToVisibilityConverter x:Key="CountToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <!-- 0 企标选择器 -->
            <RowDefinition Height="Auto" />
            <!-- 1 profile 摘要条 -->
            <RowDefinition Height="Auto" />
            <!-- 2 冲突条 -->
            <RowDefinition Height="Auto" />
            <!-- 3 语义能力横幅 -->
            <RowDefinition Height="Auto" />
            <!-- 4 partial 徽标 -->
            <RowDefinition Height="Auto" />
            <!-- 5 能力 chip -->
            <RowDefinition Height="Auto" />
            <!-- 6 标定面板（spec §10.2，可折叠） -->
            <RowDefinition Height="Auto" />
            <!-- 时间条与事件表按比例分配剩余高度：窗口高时表能多显示，
                 窗口矮时时间条保留最小可视高度，避免被固定 160px 挤没。 -->
            <RowDefinition Height="2*" MinHeight="72" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- 企标选择器（spec §10.1）：只读下拉，选中后重分析。
             分析前也显示——用户可以先选企标再跑分析。 -->
        <Border Grid.Row="0" Padding="6" Background="#F2F6FA" BorderBrush="#C7D6E4"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="企标 profile" VerticalAlignment="Center"
                               Margin="0,0,6,0" FontSize="11" Foreground="#445566" />
                    <ComboBox ItemsSource="{Binding NmProfileChoices}"
                              SelectedItem="{Binding NmSelectedProfile}"
                              DisplayMemberPath="Display"
                              ToolTip="选择企标 profile；切换后自动重算"
                              MinWidth="180" />
                </DockPanel>
                <TextBlock Text="{Binding NmProfileSelectorHint}" TextWrapping="Wrap"
                           FontSize="10" Foreground="#8A6D00" Margin="0,3,0,0"
                           Visibility="{Binding NmProfileSelectorHint, Converter={StaticResource NonEmptyStringToVis}}" />
                <TextBlock Text="{Binding NmProfileCandidatesSummary}" TextWrapping="Wrap"
                           FontSize="10" Foreground="#666666" Margin="0,2,0,0"
                           Visibility="{Binding NmProfileCandidatesSummary, Converter={StaticResource NonEmptyStringToVis}}" />
                <!-- 监听能力限制必须显式披露：不说就等于默认「父文件变更会自动生效」。 -->
                <TextBlock Text="{Binding NmProfileWatcherStatus}" TextWrapping="Wrap"
                           FontSize="10" Foreground="#8A6D00" Margin="0,2,0,0"
                           Visibility="{Binding NmProfileWatcherStatus, Converter={StaticResource NonEmptyStringToVis}}" />
            </StackPanel>
        </Border>

        <!-- Profile bar：分析前不渲染，否则空的摘要 + 空按钮会变成一条无意义的色带。 -->
        <Border Grid.Row="1" Padding="6" Background="#FFF7E6" BorderBrush="#E0C080"
                BorderThickness="0,0,0,1"
                Visibility="{Binding NmHasReport, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{Binding NmMissingText}"
                        ToolTip="打开补全对话框：选择 NM 报文、NID/CBV、站地址与时序"
                        Command="{Binding OpenNmWizardCommand}" Margin="6,0,0,0" />
                <StackPanel>
                    <TextBlock Text="{Binding NmProfileSummary}" TextWrapping="Wrap" />
                    <!-- 识别依据单独成行：与摘要挤在一起时 360px 下完全没法读。 -->
                    <TextBlock Text="{Binding NmProfileReasonText}" TextWrapping="Wrap"
                               FontSize="11" Foreground="#666666" Margin="0,2,0,0" />
                    <!-- 时间条只给窗口内观测到的报文建行：缺哪些必须在这里说明。 -->
                    <TextBlock Text="{Binding NmObservedSummary}" TextWrapping="Wrap"
                               FontSize="11" Foreground="#666666" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Conflicts bar (spec §9.1；无冲突隐藏) -->
        <Border Grid.Row="2" Padding="6" Background="#FFF4CE" BorderBrush="#E0C080"
                BorderThickness="0,0,0,1"
                Visibility="{Binding NmHasConflicts, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="配置冲突（多个来源给出不同值）" FontWeight="SemiBold" Foreground="#6B5200" />
                <!-- 冲突条数不可控：限高 + 内部滚动，避免把时间条挤到看不见。 -->
                <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NmConflictLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" Foreground="#6B5200" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- M1 semantics banner：只有能力不可用时才显示（补全后自动消失） -->
        <TextBlock Grid.Row="3" Margin="6,4" Foreground="#8A6D00"
                   Text="{Binding NmSemanticsBanner}"
                   Visibility="{Binding NmHasSemanticsBanner, Converter={StaticResource BoolToVis}}" />

        <!-- Partial result badge (spec §9.4；分析取消/超时) -->
        <Border Grid.Row="4" Padding="6" Background="#FFE0B2" BorderBrush="#E0A060"
                BorderThickness="0,0,0,1"
                Visibility="{Binding NmIsPartial, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding NmPartialText}" FontWeight="SemiBold" Foreground="#7A4300" />
        </Border>

        <!-- Capability chips -->
        <ItemsControl Grid.Row="5" ItemsSource="{Binding NmCapabilityChips}" Margin="6,2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,4,4" Padding="6,1" CornerRadius="8"
                            ToolTip="{Binding Tooltip}"
                            Background="{Binding Available, Converter={StaticResource NmChipBrush}}">
                        <TextBlock Text="{Binding Name}" FontSize="11" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 标定面板（spec §10.2）：规则三态表 + 观测 vs 期望 + 数据体检 + 未建模条款。
             默认折叠——360px 面板下四块表常驻会把时间条挤没。 -->
        <Expander Grid.Row="6" Header="标定面板" IsExpanded="False" Margin="6,2"
                  FontSize="11" FontWeight="SemiBold" Foreground="#445566"
                  Visibility="{Binding NmHasCalibration, Converter={StaticResource BoolToVis}}">
            <!-- 四块表全展开时高度远超 360px 面板。不套 ScrollViewer + MaxHeight 时，
                 StackPanel 会无限撑高，把下面的时间条与事件表挤到各自的 MinHeight，
                 超出部分直接被裁掉——用户看不到也滚不到。
                 MaxHeight 是必需的：只加 ScrollViewer 而外层是 Auto 行时，它会被内容
                 撑到自然高度，滚动条永不出现。220px 约为面板可用高度的六成，
                 保证时间条与事件表始终可见。 -->
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,2,0,0">
                <!-- 规则表：每条规则 → 触发 / 未触发 / 未建模 / 不适用，点击 seek 到证据时刻 -->
                <DockPanel Margin="0,4,0,2">
                    <TextBlock DockPanel.Dock="Left" Text="规则" FontSize="10" FontWeight="SemiBold"
                               Foreground="#666666" />
                    <!-- 一句话汇总：21 行平铺时用户得自己数哪几条挂了。 -->
                    <TextBlock Text="{Binding NmCalibrationSummary}" FontSize="10"
                               Foreground="#666666" HorizontalAlignment="Right" />
                </DockPanel>
                <!-- 规则表按「结构相同的规则」分组：吉利 13 条预留位检查折叠成一行，
                     否则它们占掉半屏，把最该看的触发行淹掉。
                     组内结论不一致时不折叠（Core 的 NmCalibrationGroup.IsCollapsed 决定）。 -->
                <ItemsControl ItemsSource="{Binding NmCalibrationGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- 折叠头：只在组可折叠时出现。有违规的组标题变红，
                                     用户扫到折叠行就知道这里有问题，不必展开。 -->
                                <Border Padding="4,2" Margin="0,1" Background="#EEF3F8" CornerRadius="3"
                                        Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVis}}">
                                    <!-- Dock 顺序很重要：按钮与摘要先按内容占宽（Right），
                                         标题最后用 * 填剩余。反过来（标题先拿固定宽）时
                                         280px 面板下摘要只剩约 55px，「13 未建模」会被
                                         省略号截成「13 …」——状态词消失，用户看不出查没查。 -->
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{Binding ToggleText}" FontSize="10"
                                                Padding="6,0" Margin="4,0,0,0"
                                                Command="{Binding DataContext.ToggleNmCalibrationGroupCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CollapsedSummary}"
                                                   FontSize="10" Margin="4,0,0,0"
                                                   ToolTip="{Binding CollapsedSummary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#666666" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasViolation}" Value="True">
                                                            <Setter Property="Foreground" Value="#C0392B" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasUnmodeled}" Value="True">
                                                            <Setter Property="Foreground" Value="#B26A00" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding CollapsedHeader}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Title}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#33475B" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasViolation}" Value="True">
                                                            <Setter Property="Foreground" Value="#C0392B" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasUnmodeled}" Value="True">
                                                            <Setter Property="Foreground" Value="#B26A00" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                                <!-- 组内逐条：折叠头显示时不重复（IsExpanded 由「展开」按钮控制）。 -->
                                <ItemsControl ItemsSource="{Binding Rows}"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- spec §10.2「点击 seek 到证据时刻」：有证据时刻的行才可点。
                                                 无证据（未触发/未建模）时 Cursor 保持默认，避免「看起来能点但没反应」。
                                                 ToolTip 给完整含义 + 条款号：正文 Title 被省略号截断后，
                                                 截掉的尾部常常正是条款号，必须有个地方能看全文。 -->
                                            <Border Padding="4,2" Margin="0,1" Background="#F7F9FB" CornerRadius="3"
                                                    ToolTip="{Binding ToolTipText}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Cursor" Value="Arrow" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanSeek}" Value="True">
                                                                <Setter Property="Cursor" Value="Hand" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SeekToNmTimeOrIgnoreCommand,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding FirstEvidenceTime}" />
                                                </Border.InputBindings>
                                                <!-- 两行布局：标题行（状态 + 规则含义），说明行（是什么 / 凭什么）。
                                                     单行时 360px 面板里 Reason 被挤成 0 宽，等于没显示。 -->
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}"
                                                                   FontSize="10" FontWeight="SemiBold" Width="44">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#666666" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StatusText}" Value="触发">
                                                                            <Setter Property="Foreground" Value="#C0392B" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusText}" Value="未建模">
                                                                            <Setter Property="Foreground" Value="#B26A00" />
                                                                        </DataTrigger>
                                                                        <!-- 「不适用」不是问题也不是通过：用冷色，避免与触发/未建模混淆。 -->
                                                                        <DataTrigger Binding="{Binding StatusText}" Value="不适用">
                                                                            <Setter Property="Foreground" Value="#4A6C8C" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <!-- 规则的中文含义：用户扫一眼就知道这条在查什么，
                                                             不必逐行 hover。 -->
                                                        <TextBlock Text="{Binding Title}" FontSize="10"
                                                                   FontWeight="SemiBold" Foreground="#33475B"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <!-- 说明行：触发→finding 原文；未触发→基于几条观测；
                                                         未建模/不适用→原因与原因码。 -->
                                                    <TextBlock Text="{Binding Summary}" FontSize="10"
                                                               Foreground="#555555" Margin="44,1,0,0"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 观测 vs 期望 -->
                <TextBlock Text="观测 vs 期望" FontSize="10" FontWeight="SemiBold" Foreground="#666666"
                           Margin="0,6,0,2"
                           Visibility="{Binding NmCalibrationComparisons.Count,
                                                Converter={StaticResource CountToVis}}" />
                <ItemsControl ItemsSource="{Binding NmCalibrationComparisons}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,1">
                                <Run Text="{Binding Subject, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" 期望 " />
                                <Run Text="{Binding Expected, Mode=OneWay}" />
                                <Run Text=" ｜ " />
                                <Run Text="{Binding Observed, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 数据体检（§9.2 三态） -->
                <TextBlock Text="数据体检" FontSize="10" FontWeight="SemiBold" Foreground="#666666"
                           Margin="0,6,0,2"
                           Visibility="{Binding NmDataQualityChecks.Count,
                                                Converter={StaticResource CountToVis}}" />
                <ItemsControl ItemsSource="{Binding NmDataQualityChecks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,1">
                                <Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" ｜ " />
                                <Run Text="{Binding Detail, Mode=OneWay}" Foreground="#555555" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 未建模条款（spec §10.2：显式列出，附条款号） -->
                <TextBlock Text="未建模条款" FontSize="10" FontWeight="SemiBold" Foreground="#666666"
                           Margin="0,6,0,2"
                           Visibility="{Binding NmUnmodeledClauses.Count,
                                                Converter={StaticResource CountToVis}}" />
                <ItemsControl ItemsSource="{Binding NmUnmodeledClauses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,1">
                                <Run Text="{Binding RuleId, Mode=OneWay}" FontWeight="SemiBold" />
                                <!-- spec §10.2「显式列出，附条款号」：多条款规则要全列。 -->
                                <Run Text="{Binding ClausesText, Mode=OneWay}" Foreground="#23364D" />
                                <Run Text=" " />
                                <Run Text="{Binding Reason, Mode=OneWay}" Foreground="#555555" />
                                <Run Text="{Binding ReasonCode, Mode=OneWay, StringFormat=（{0}）}"
                                     Foreground="#8A6D00" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            </ScrollViewer>
        </Expander>

        <!-- 分析前的空态：告诉用户从哪开始，而不是留一块空白。 -->
        <TextBlock Grid.Row="7" Text="尚未分析 NM：点击下方「分析全 trace」或「分析当前窗口」"
                   Margin="10,16" FontSize="12" Foreground="#777777" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NmHasReport}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Timeline (design width 1000, Viewbox scales to panel) -->
        <ScrollViewer Grid.Row="7" VerticalScrollBarVisibility="Auto"
                      ScrollChanged="OnNmTimelineScrollChanged"
                      Visibility="{Binding NmHasReport, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- 时间条宿主：承载跨行准星。Canvas 覆盖层不参与命中测试，
                     鼠标事件统一由宿主处理。 -->
                <Grid x:Name="NmTimelineTrackHost" Background="Transparent"
                      MouseMove="OnNmTimelineMouseMove"
                      MouseLeave="OnNmTimelineMouseLeave">
                  <StackPanel>
                <ItemsControl ItemsSource="{Binding NmTimelineRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3,2,3">
                                <!-- 报文名/发送者可很长：省略号 + ToolTip，不让它把行撑出面板。 -->
                                <TextBlock Text="{Binding Label}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                <!-- 活动条：设计坐标经 Viewbox 横向缩放，只承载区间，不放标记。 -->
                                <Viewbox Stretch="Fill" Height="12">
                                    <Canvas Width="{x:Static vm:TraceViewerViewModel.NmTimelineWidth}"
                                            Height="12">
                                        <ItemsControl ItemsSource="{Binding Segments}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <!-- Canvas.Left 必须设在容器 ContentPresenter 上：
                                                 ItemsControl 会为每项包一层容器，写在 Rectangle 上不生效。 -->
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                    <Setter Property="Canvas.Top" Value="0" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- hover：描边提亮 + 手型；信息卡由 View 的
                                                         MouseEnter/Leave 驱动，替代原生 tooltip。 -->
                                                    <Rectangle Height="12" Cursor="Hand"
                                                               AutomationProperties.Name="{Binding Tooltip}"
                                                               Fill="{Binding Kind, Converter={StaticResource NmSegmentBrush}}"
                                                               Width="{Binding Width}"
                                                               MouseEnter="OnNmSegmentMouseEnter"
                                                               MouseLeave="OnNmSegmentMouseLeave">
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <!-- spec §7.5.2.1：证据的视觉区分与文案必须同批。
                                                                     推断段降透明度——「这段是猜的」必须看得出来，
                                                                     不能只有 hover 时才说。 -->
                                                                <Setter Property="Opacity" Value="1" />
                                                                <Style.Triggers>
                                                                    <!-- spec §7.5.2.1：推断段降透明度，让「这段是猜的」看得出来。
                                                                         取 0.7 而非 0.55：SilentBrush / UnknownStateBrush 本身
                                                                         alpha 已是 0x80，再乘 0.55 只剩约 28%，深色背景上几乎不可见。 -->
                                                                    <DataTrigger Binding="{Binding Evidence}" Value="inferred">
                                                                        <Setter Property="Opacity" Value="0.7" />
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <!-- 描边在 Viewbox 内会被横向缩小（360px 面板约 ×0.36），
                                                                             用 3 设计单位保证屏幕上仍有约 1px 可见。 -->
                                                                        <Setter Property="Stroke" Value="#1D2C3F" />
                                                                        <Setter Property="StrokeThickness" Value="3" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                        <Rectangle.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.SeekToNmTimeCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          CommandParameter="{Binding Start}" />
                                                        </Rectangle.InputBindings>
                                                    </Rectangle>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>
                                </Viewbox>

                                <!-- 事件轨道：固定在像素空间，不经 Viewbox 横向缩放。
                                     否则 9px 标记在 360px 面板里会被压成约 1px，tooltip/点击都失效。 -->
                                <Canvas Height="14" Margin="0,1,0,0"
                                        Width="{Binding ActualWidth,
                                                       RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                        Visibility="{Binding HasMarkers, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding Markers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Top" Value="1" />
                                                <Setter Property="Canvas.Left">
                                                    <Setter.Value>
                                                        <!-- (设计X, 轨道实际宽度) → 像素左缘，居中并钳制在轨道内。
                                                             宽度必须取行根 StackPanel：最近的 Canvas 祖先是
                                                             ItemsPanel 生成的内层 Canvas，其 ActualWidth 恒为 0。 -->
                                                        <MultiBinding Converter="{StaticResource NmPixelX}">
                                                            <Binding Path="X" />
                                                            <Binding Path="ActualWidth"
                                                                     RelativeSource="{RelativeSource AncestorType=StackPanel}" />
                                                        </MultiBinding>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="9" Height="12" Background="Transparent"
                                                      AutomationProperties.Name="{Binding Tooltip}"
                                                      MouseEnter="OnNmMarkerMouseEnter"
                                                      MouseLeave="OnNmMarkerMouseLeave">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="RenderTransformOrigin" Value="0.5,1" />
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Path x:Name="Shape" Width="9" Height="9"
                                                          Stretch="Uniform"
                                                          Data="{Binding Kind, Converter={StaticResource NmEventShape}}"
                                                          Fill="{Binding Kind, Converter={StaticResource NmSegmentBrush}}" />
                                                    <!-- 记录边界是竖线而不是形状标记。 -->
                                                    <Rectangle x:Name="Bar" Width="2" Height="12"
                                                               Visibility="Collapsed"
                                                               Fill="{Binding Kind, Converter={StaticResource NmSegmentBrush}}" />
                                                    <Grid.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.SeekToNmTimeCommand,
                                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      CommandParameter="{Binding T}" />
                                                    </Grid.InputBindings>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="boundary">
                                                        <Setter TargetName="Shape" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 时间轴：设计坐标把窗口起止映射到 0/1000，中点正好 50%，
                     因此左/中/右三个标签与轨道位置天然对齐。 -->
                <Grid Margin="2,6,2,0">
                    <Border Height="1" Background="#DDDDDD" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding NmTimeAxisStart}" HorizontalAlignment="Left"
                               FontSize="9" Foreground="#666666" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding NmTimeAxisMid}" HorizontalAlignment="Center"
                               FontSize="9" Foreground="#666666" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding NmTimeAxisEnd}" HorizontalAlignment="Right"
                               FontSize="9" Foreground="#666666" Margin="0,4,0,0" />
                </Grid>
                  </StackPanel>

                  <!-- 准星覆盖层：横向跨所有行，顶部时间读数随鼠标移动。 -->
                  <Canvas IsHitTestVisible="False"
                          Visibility="{Binding NmHoverActive, Converter={StaticResource BoolToVis}}">
                      <Rectangle x:Name="NmCrosshairBand" Canvas.Top="0" Width="22"
                                 Height="{Binding ActualHeight, ElementName=NmTimelineTrackHost}"
                                 Fill="#142E7DD2" />
                      <Rectangle x:Name="NmCrosshairLine" Canvas.Top="0" Width="1"
                                 Height="{Binding ActualHeight, ElementName=NmTimelineTrackHost}"
                                 Fill="#992E7DD2" />
                      <Border x:Name="NmHoverChip" Canvas.Top="4" Width="56" Height="18"
                              Background="#23364D" CornerRadius="4">
                          <TextBlock Text="{Binding NmHoverTimeText}" Foreground="White"
                                     FontSize="10" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                      </Border>
                  </Canvas>
                </Grid>

                <!-- 图例默认折叠：常驻三行会吃掉 360px 面板约 60px 垂直空间。
                     颜色/形状仍与轨道同源（x:Static 引用转换器笔刷）。 -->
                <Expander Header="图例" IsExpanded="False" Margin="2,6,2,4"
                          FontSize="10" FontWeight="SemiBold" Foreground="#555555">
                    <StackPanel Margin="0,2,0,0">
                    <!-- 每行显式 Normal：Expander 的 SemiBold 会向内容继承，图例正文不能变粗体。 -->
                    <TextBlock FontSize="10" FontWeight="Normal" TextWrapping="Wrap" Margin="0,2,0,0">
                        <Run Text="报文条（时间推断）  " Foreground="#666666" />
                        <Run Text="■ 唤醒  "
                             Foreground="{x:Static conv:NmSegmentBrushConverter.WakeupBrush}" />
                        <Run Text="■ 发送中  "
                             Foreground="{x:Static conv:NmSegmentBrushConverter.ActiveBrush}" />
                        <Run Text="■ 已释放  "
                             Foreground="{x:Static conv:NmSegmentBrushConverter.ReleasedBrush}" />
                        <Run Text="■ 静默"
                             Foreground="{x:Static conv:NmSegmentBrushConverter.SilentBrush}" />
                    </TextBlock>
                    <!-- spec §7.5.4：有 NMSts 时按状态切段，与上面的时间推断分开列。 -->
                    <TextBlock FontSize="10" FontWeight="Normal" TextWrapping="Wrap" Margin="0,2,0,0">
                        <Run Text="报文条（NMSts 实测）  " Foreground="#666666" />
                        <Run Text="■ 重复报文  "
                             Foreground="{x:Static conv:NmSegmentBrushConverter.RepeatBrush}" />
                        <Run Text="■ 常规操作  "
                             Foreground="{x:Static conv:NmSegmentBrushConverter.NormalBrush}" />
                        <Run Text="■ 快速发送  "
                             Foreground="{x:Static conv:NmSegmentBrushConverter.ImmediateBrush}" />
                        <Run Text="■ 状态未知"
                             Foreground="{x:Static conv:NmSegmentBrushConverter.UnknownStateBrush}" />
                    </TextBlock>
                    <TextBlock FontSize="10" FontWeight="Normal" TextWrapping="Wrap" Margin="0,2,0,0">
                        <Run Text="事件  " Foreground="#666666" />
                        <Run Text="▲ 突发  "
                             Foreground="{x:Static conv:NmSegmentBrushConverter.BurstBrush}" />
                        <Run Text="▼ 空档/漏帧  "
                             Foreground="{x:Static conv:NmSegmentBrushConverter.GapBrush}" />
                        <Run Text="■ 字节变化  "
                             Foreground="{x:Static conv:NmSegmentBrushConverter.ByteBrush}" />
                        <Run Text="◆ 位变化  "
                             Foreground="{x:Static conv:NmSegmentBrushConverter.BitBrush}" />
                        <Run Text="● 信号变化"
                             Foreground="{x:Static conv:NmSegmentBrushConverter.SignalBrush}" />
                    </TextBlock>
                    <TextBlock FontSize="10" FontWeight="Normal" TextWrapping="Wrap" Margin="0,2,0,0">
                        <Run Text="整网行  " Foreground="#666666" />
                        <Run Text="■ 活跃区间  "
                             Foreground="{x:Static conv:NmSegmentBrushConverter.EpisodeBrush}" />
                        <Run Text="■ 静默（无 NM 报文）  "
                             Foreground="{x:Static conv:NmSegmentBrushConverter.SilentBrush}" />
                        <Run Text="│ 记录边界"
                             Foreground="{x:Static conv:NmSegmentBrushConverter.BoundaryBrush}" />
                    </TextBlock>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Event filters (spec §9.1) -->
        <!-- 右侧面板只有 360px：用 WrapPanel，窄宽度时换行而不是裁掉右侧计数。 -->
        <WrapPanel Grid.Row="8" Margin="6,2"
                   Visibility="{Binding NmHasReport, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="筛选" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox ItemsSource="{Binding NmEventTypeFilters}"
                      SelectedItem="{Binding NmSelectedEventTypeFilter}"
                      Width="86" Margin="0,0,6,4" />
            <TextBox Text="{Binding NmEventKeyword, UpdateSourceTrigger=PropertyChanged}"
                     Width="120" ToolTip="按对象/详情关键字筛选" Margin="0,0,8,4" />
            <TextBlock Text="{Binding NmEventFilterSummary}" VerticalAlignment="Center"
                       FontSize="11" Margin="0,0,0,4" />
        </WrapPanel>

        <!-- Actions：按钮换行时状态文案独立成行，避免被挤到面板外。 -->
        <StackPanel Grid.Row="9" Margin="6">
            <WrapPanel>
                <Button Content="分析全 trace" Command="{Binding AnalyzeNmFullCommand}"
                        ToolTip="分析整个 trace 时间范围" Margin="0,0,6,4" />
                <Button Content="分析当前窗口" Command="{Binding AnalyzeNmWindowCommand}"
                        ToolTip="只分析图表当前可见的时间范围" Margin="0,0,6,4" />
                <Button Content="取消分析" Command="{Binding CancelNmAnalysisCommand}"
                        IsEnabled="{Binding NmCanCancel}" Margin="0,0,6,4" />
                <Button Content="导出报告" Command="{Binding ExportNmReportCommand}" Margin="0,0,6,4" />
                <Button Content="让 AI 总结本次分析" Command="{Binding SummarizeNmInAiCommand}"
                        ToolTip="把分析结果交给 AI 汇总并给排查建议（只填入问题，确认后才发送）"
                        ToolTipService.ShowOnDisabled="True"
                        Margin="0,0,6,4" />
                <Button Content="在 AI 中解读选中事件" Command="{Binding InterpretNmEventInAiCommand}"
                        ToolTip="先在下方事件表选中一行；点击后跳到 AI 对话并填入问题"
                        ToolTipService.ShowOnDisabled="True"
                        Margin="0,0,6,4" />
                <ProgressBar IsIndeterminate="True" Width="70" Height="6" Margin="0,0,6,4"
                             VerticalAlignment="Center"
                             Visibility="{Binding NmIsAnalyzing, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="分析中…（可取消）" VerticalAlignment="Center" Foreground="#8A6D00"
                           Margin="0,0,8,4"
                           Visibility="{Binding NmIsAnalyzing, Converter={StaticResource BoolToVis}}" />
            </WrapPanel>
            <TextBlock Text="{Binding NmStatus}" TextWrapping="Wrap" Foreground="#444444" />
            <!-- 一句话说明分工：用户此前反复问“AI 是拿来干嘛的”。 -->
            <TextBlock Text="面板展示实测事实与证据；AI 负责解释和进一步排查。"
                       FontSize="10" Foreground="#888888" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Event table -->
        <DataGrid Grid.Row="10" ItemsSource="{Binding NmEventRows}" IsReadOnly="True"
                  AutoGenerateColumns="False" SelectionMode="Single"
                  SelectedItem="{Binding NmSelectedEvent}"
                  PreviewMouseLeftButtonUp="OnEventRowClick"
                  MouseDoubleClick="OnEventRowDoubleClick"
                  Visibility="{Binding NmHasReport, Converter={StaticResource BoolToVis}}">
            <DataGrid.Columns>
                <!-- 面板可拖到 MinWidth=280（TraceViewerView.xaml:226），360 只是默认值。
                     固定列 64+74+96=234，在 280 下详情列只剩约 46px——不可读。
                     详情列用 * + MinWidth：窗口窄时横向滚动而不是把详情压成 0 宽。
                     对象列用模板列：显示 SubjectLabel（名字 (ID)），ToolTip 给全文，
                     因为 96px 放不下「NM_Message (0x18FFFA27)」。 -->
                <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="64" />
                <DataGridTextColumn Header="类型" Binding="{Binding TypeLabel}" Width="74" />
                <DataGridTemplateColumn Header="对象" Width="96">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SubjectLabel}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SubjectLabel}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- 证据级别并入详情列：单字图标 + 颜色，省下独立「证据」列的 52px；
                     完整级别仍由 ToolTip/AutomationProperties 提供。 -->
                <!-- MinWidth 是必需的：面板可拖到 280px，固定列已占 234px。
                     没有 MinWidth 时 * 列会被压到约 46px，详情等于不可读；
                     有了它窗口窄时出现横向滚动条，内容仍完整。 -->
                <DataGridTemplateColumn Header="详情" Width="*" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding EvidenceGlyph}"
                                           ToolTip="{Binding EvidenceLabel}"
                                           AutomationProperties.Name="{Binding EvidenceLabel}"
                                           Margin="0,0,3,0" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#666666" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EvidenceKind}" Value="measured">
                                                    <Setter Property="Foreground" Value="#1A7F37" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EvidenceKind}" Value="inferred">
                                                    <Setter Property="Foreground" Value="#B26A00" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Detail}" />
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 活动段信息卡：单例 Popup，PlacementTarget 在鼠标进入段时切换，
             由 WPF 负责贴近面板边缘时自动翻转。 -->
        <Popup x:Name="NmSegmentPopup" Placement="Top" VerticalOffset="-6"
               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade"
               IsHitTestVisible="False">
            <Border MaxWidth="240" Padding="10,8" Background="White"
                    BorderBrush="#D7DEE7" BorderThickness="1" CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22" />
                </Border.Effect>
                <StackPanel>
                    <!-- 图标与标题用 Grid（Auto + *）：横向 StackPanel 会给标题无限
                         测量宽度，TextWrapping 失效，长标题被 MaxWidth 直接裁掉。 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2"
                                   VerticalAlignment="Top" Margin="0,4,0,0"
                                   Fill="{Binding NmHoverKind, Converter={StaticResource NmSegmentBrush}}" />
                        <TextBlock Grid.Column="1" Text="{Binding NmHoverTitle}"
                                   FontWeight="SemiBold" FontSize="12"
                                   Margin="6,0,0,0" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="{Binding NmHoverRange}" FontSize="11" Margin="14,4,0,0"
                               TextWrapping="Wrap" Foreground="#23364D" />
                    <!-- spec §7.5.2.1：证据等级独立一行；空串时整行不占位。 -->
                    <TextBlock Text="{Binding NmHoverEvidence}" FontSize="10" Margin="14,2,0,0"
                               TextWrapping="Wrap" Foreground="#8A6D1F" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding NmHoverHint}" FontSize="10" Margin="14,2,0,0"
                               TextWrapping="Wrap" Foreground="#6B7785" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
