<Window x:Class="PeakCan.Host.App.Views.NmInputWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="补全 NM 输入" Width="1000" Height="700" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <!-- 中栏容纳“标签 86 + 5~6 个 48px 字节按钮”一行；330 会让每帧都换行。 -->
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：缺项列表（每条建议都可「采用建议」，解析不了则要求手动确认） -->
        <ListBox Grid.Column="0" ItemsSource="{Binding MissingItems}" Margin="0,0,8,0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <!-- 缺项文本必须拿到整列宽度才会换行，否则横向溢出被裁。 -->
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Capability}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Why}" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Suggestion}" FontSize="11" Foreground="#555" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Impact, StringFormat='影响：{0}'}"
                                   FontSize="11" Foreground="#8A3B00" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Status, StringFormat='状态：{0}'}"
                                   FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <Button Content="采用建议" FontSize="11" Margin="0,2,0,0" Padding="6,1"
                                HorizontalAlignment="Left"
                                Command="{Binding DataContext.AdoptMissingItemCommand,
                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 中：样本字节预览（同一条 NM 候选的 1–3 帧，HEX，业务侧只看十六进制）。
             DPI 放大或窗口缩到最小时字节会多换几行，这里允许纵向滚动而不是裁掉。 -->
        <ScrollViewer Grid.Column="1" Margin="0,0,8,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="样本预览（HEX，最多 3 帧；点击字节设为 NID/CBV）"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding SampleRows}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="{Binding Label}" Width="86" FontSize="11"
                                       VerticalAlignment="Center" FontFamily="Consolas" />
                            <ItemsControl ItemsSource="{Binding Bytes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="46" Height="32" Margin="1" Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Command="{Binding SelectCommand}"
                                                ToolTip="{Binding BitsText}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding HexText}" FontFamily="Consolas"
                                                           FontSize="11" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding BitsText}" FontFamily="Consolas"
                                                           FontSize="8" Foreground="#666666"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#FFFFFF" />
                                                    <Setter Property="BorderBrush" Value="#CCCCCC" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#FFD54F" />
                                                            <Setter Property="BorderBrush" Value="#B8860B" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Status}" Margin="0,8" TextWrapping="Wrap" Foreground="#8A6D00" />
        </StackPanel>
        </ScrollViewer>

        <!-- 右：报文候选 + 编辑区 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="120" />
                <RowDefinition Height="*" />
                <!-- 主操作固定在底部，不随编辑区滚动消失。 -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="NM 报文候选（DBC 无 NM 标记时在此勾选）"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <ListBox Grid.Row="1" ItemsSource="{Binding MessageCandidates}" Margin="0,2,0,8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CanIdHex}" FontFamily="Consolas" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="当前字节解码" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedByteDecode}" FontFamily="Consolas"
                               TextWrapping="Wrap" Margin="0,0,0,6" />

                    <TextBlock Text="NID 字节" /><TextBox Text="{Binding NidByte, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="CBV 字节" /><TextBox Text="{Binding CbvByte, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="用户数据 offset" /><TextBox Text="{Binding UserDataOffset, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="用户数据 length" /><TextBox Text="{Binding UserDataLength, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="周期 (ms)" /><TextBox Text="{Binding CycleMs, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="超时 (ms)" /><TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="PN 启用" />
                    <CheckBox IsChecked="{Binding PnEnabled}" IsThreeState="True" />

                    <!-- 节点站地址：NidCheck 在 UI 内解锁的唯一路径 -->
                    <TextBlock Text="节点站地址（0–255）" FontWeight="SemiBold" Margin="0,10,0,2" />
                    <ItemsControl ItemsSource="{Binding NodeAddresses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding Name}" Width="140"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBox Width="70"
                                             Text="{Binding StationAddress, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 试算展示：识别报文 / 周期中位 / NID 分布 / 空档 / 突发 -->
                    <TextBlock Text="试算结果" FontWeight="SemiBold" Margin="0,10,0,2" />
                    <TextBlock Text="{Binding TrialSummary}" FontFamily="Consolas" FontSize="11"
                               TextWrapping="Wrap" Foreground="#333333" />
                </StackPanel>
            </ScrollViewer>

            <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                <Button Content="试算当前窗口" Command="{Binding TrialCommand}" Margin="0,0,6,4" />
                <Button Content="保存到项目" Command="{Binding SaveCommand}" Margin="0,0,6,4" />
                <Button Content="导出配置" Command="{Binding ExportProfileCommand}" Margin="0,0,6,4" />
                <Button Content="导入配置" Command="{Binding ImportProfileCommand}" Margin="0,0,6,4" />
                <Button Content="取消" Click="OnCancelClick" Margin="0,0,0,4" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
