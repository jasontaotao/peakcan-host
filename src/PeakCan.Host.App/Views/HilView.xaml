<UserControl x:Class="PeakCan.Host.App.Views.HilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PeakCan.Host.App.ViewModels"
             xmlns:core="clr-namespace:PeakCan.HIL.Core.HIL;assembly=PeakCan.HIL.Core"
             xmlns:conv="clr-namespace:PeakCan.Host.App.Composition.Converters"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="HilModeValues" MethodName="GetValues" ObjectType="{x:Type core:HilMode}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="core:HilMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <!-- Browse 字段空态占位符样式 -->
        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <conv:HilModeToIconConverter x:Key="HilModeIcon" />
        <conv:HilModeToDescriptionConverter x:Key="HilModeDesc" />
    </UserControl.Resources>
    <DockPanel Margin="16">
        <!-- Mode selector + DBC / Suite paths -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="模式" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox MinWidth="150" Margin="0,0,16,0"
                      ItemsSource="{Binding Source={StaticResource HilModeValues}}"
                      SelectedItem="{Binding SelectedMode}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Converter={StaticResource HilModeIcon}}" Margin="0,0,6,0"
                                       FontFamily="Segoe Fluent Icons" />
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox Content="记录每 case 报文 (.asc)" IsChecked="{Binding CaptureCaseLogs}"
                      VerticalAlignment="Center" Margin="16,0,0,0" />
            <Grid MinWidth="220" Margin="12,0,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CaptureCaseLogs}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <TextBox Text="{Binding CaseLogDirectory}" ToolTip="Case log directory" />
            </Grid>
            <Button Content="打开日志" Command="{Binding OpenCaseLogDirectoryCommand}" Margin="4,0,0,0" />
            <TextBlock Text="{Binding SelectedMode, Converter={StaticResource HilModeIcon}}"
                       ToolTip="{Binding SelectedMode, Converter={StaticResource HilModeDesc}}"
                       VerticalAlignment="Center" Margin="0,0,8,0" FontSize="16"
                       FontFamily="Segoe Fluent Icons" />
            <Grid MinWidth="180" Margin="0,0,4,0">
                <TextBox x:Name="DbcPathBox" Text="{Binding DbcPath}" ToolTip="DBC file path" />
                <TextBlock Text="选择 DBC 文件..." Style="{StaticResource HintTextStyle}"
                           Visibility="{Binding Text, ElementName=DbcPathBox,
                                        Converter={StaticResource EmptyStringToVisibilityConverter}}" />
            </Grid>
            <Button Content="浏览..." Command="{Binding BrowseDbcCommand}" Margin="0,0,12,0" />
            <Grid MinWidth="180" Margin="0,0,4,0">
                <TextBox x:Name="SuitePathBox" Text="{Binding SuitePath}" ToolTip="Test suite JSON path" />
                <TextBlock Text="选择测试套件 JSON..." Style="{StaticResource HintTextStyle}"
                           Visibility="{Binding Text, ElementName=SuitePathBox,
                                        Converter={StaticResource EmptyStringToVisibilityConverter}}" />
            </Grid>
            <Button Content="浏览..." Command="{Binding BrowseSuiteCommand}" />
        </WrapPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding PreflightWarning}" Foreground="{StaticResource Error}"
                   TextWrapping="Wrap" Margin="0,0,0,8"
                   Visibility="{Binding PreflightWarning, Converter={StaticResource EmptyStringToVisibilityConverter}, ConverterParameter=invert}" />

        <!-- Mode-specific path (按 Mode 切换显隐) -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsTraceMode, Converter={StaticResource BoolToVis}}">
                <Grid MinWidth="260" Margin="0,0,4,0">
                    <TextBox x:Name="TracePathBox" Text="{Binding TracePath}" ToolTip="Trace file (ASC/BLF)" />
                    <TextBlock Text="选择 Trace 文件 (.asc/.blf)..." Style="{StaticResource HintTextStyle}"
                               Visibility="{Binding Text, ElementName=TracePathBox,
                                            Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                </Grid>
                <Button Content="浏览..." Command="{Binding BrowseTraceCommand}" Margin="0,0,12,0" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsHardwareMode, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <!-- G3: 动态刷新已连接通道（Handle 值 "USB{n}" + Display 连接信息）；多通道 suite 置灰 -->
                    <ComboBox ItemsSource="{Binding AvailableChannels}"
                              SelectedValue="{Binding HardwareChannel}"
                              SelectedValuePath="Handle"
                              DisplayMemberPath="Display"
                              MinWidth="170" Margin="0,0,12,0"
                              ToolTip="PCAN hardware channel（已连接通道）">
                      <ComboBox.Style>
                        <Style TargetType="ComboBox">
                          <Setter Property="IsEnabled" Value="True"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMultiChannelSuite}" Value="True">
                              <Setter Property="IsEnabled" Value="False"/>
                              <Setter Property="ToolTip" Value="通道由套件声明按序绑定（多通道，见下方映射）"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ComboBox.Style>
                    </ComboBox>
                </StackPanel>
                <!-- 产品 review: 多通道映射清单（只读）——bus-a→USB1 绑定可见，消除黑盒。
                     单通道（IsMultiChannelSuite=false）隐藏，避免占用横向空间。 -->
                <ItemsControl ItemsSource="{Binding ChannelBindings}"
                              Margin="0,4,0,0"
                              Visibility="{Binding IsMultiChannelSuite, Converter={StaticResource BoolToVis}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Margin="0,1">
                        <TextBlock Text="{Binding SuiteName}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text=" → " Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="{Binding Handle}" Foreground="{StaticResource Accent}" />
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondary}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding IsVirtualEcuMode, Converter={StaticResource BoolToVis}}">
                <Grid MinWidth="160" Margin="0,0,4,0">
                    <TextBox x:Name="EcuScriptPathBox" Text="{Binding EcuScriptPath}" ToolTip="ECU script JSON path" />
                    <TextBlock Text="选择 ECU 脚本..." Style="{StaticResource HintTextStyle}"
                               Visibility="{Binding Text, ElementName=EcuScriptPathBox,
                                            Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                </Grid>
                <Button Content="浏览..." Command="{Binding BrowseEcuCommand}" Margin="0,0,12,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding IsMatrixMode, Converter={StaticResource BoolToVis}}">
                <Grid MinWidth="160" Margin="0,0,4,0">
                    <TextBox x:Name="MatrixPathBox" Text="{Binding MatrixPath}" ToolTip="Matrix config JSON path" />
                    <TextBlock Text="选择矩阵配置 JSON..." Style="{StaticResource HintTextStyle}"
                               Visibility="{Binding Text, ElementName=MatrixPathBox,
                                            Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                </Grid>
                <Button Content="浏览..." Command="{Binding BrowseMatrixCommand}" Margin="0,0,12,0" />
            </StackPanel>

            <CheckBox Content="注入故障" IsChecked="{Binding EnableFaultInjection}"
                      VerticalAlignment="Center" Margin="0,0,12,0" />
            <CheckBox Content="分析" IsChecked="{Binding EnableAnalyze}"
                      VerticalAlignment="Center" Margin="0,0,12,0" />
        </WrapPanel>

        <!-- ECU editor + Run / Analyze buttons -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Content="打开 ECU 编辑器" Command="{Binding OpenEcuEditorCommand}" Padding="16,4" Margin="0,0,8,0" />
            <Button Content="运行" Command="{Binding RunCommand}" Padding="24,4" Margin="0,0,8,0" />
            <Button Content="停止" Command="{Binding StopCommand}" Padding="16,4" Margin="0,0,8,0" />
            <Button Content="试运行环境" Command="{Binding TrialRunEnvironmentCommand}" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="分析" Command="{Binding AnalyzeCommand}" Padding="16,4" />
        </WrapPanel>

        <!-- Progress bar + current case / elapsed / status -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="{Binding CurrentCaseName, StringFormat=正在执行: {0}}" Margin="0,0,4,0" />
            <TextBlock Text="{Binding CompletedCases, StringFormat=({0}/}" />
            <TextBlock Text="{Binding TotalCases, StringFormat={}{0})}" Margin="0,0,8,0" />
            <TextBlock Text="{Binding RunElapsedText, StringFormat=已用时 {0}}" />
        </StackPanel>
        <ProgressBar DockPanel.Dock="Top" Height="16" Margin="0,0,0,4"
                     Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Margin="0,0,0,8" />
        <!-- M2 gap: 环境节点运行状态指示（spec §4.6 + §5.5） -->
        <Expander DockPanel.Dock="Top" Header="环境状态" IsExpanded="False" Margin="0,0,0,8"
                  Visibility="{Binding HasEnvironmentStats, Converter={StaticResource BoolToVis}}">
            <DataGrid ItemsSource="{Binding EnvironmentStats}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="120">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="节点" Binding="{Binding NodeName}" Width="*" />
                    <DataGridTextColumn Header="发帧数" Binding="{Binding FramesSent}" Width="80" />
                    <DataGridTextColumn Header="规则命中" Binding="{Binding RulesMatched}" Width="80" />
                    <DataGridTextColumn Header="UDS响应" Binding="{Binding UdsResponses}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </Expander>

        <!-- Phase 7 Unit C: 中部填充区改 TabControl —— Results(原 DataGrid+TreeView) / HTML Report(WebView2)。
             LLM Analysis TextBox 保留 DockPanel 底部（T3）。 -->
        <Expander DockPanel.Dock="Top" Header="试运行诊断" Margin="0,0,0,8">
            <DataGrid ItemsSource="{Binding TrialDiagnostics}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="160">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Step" Binding="{Binding Step}" Width="120" />
                    <DataGridCheckBoxColumn Header="Passed" Binding="{Binding Passed}" Width="70" />
                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                    <DataGridTextColumn Header="Possible causes" Binding="{Binding PossibleCauses}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Expander>

        <TabControl>
            <!-- Test Cases: Browse Suite 后列出用例, 用户勾选要运行的用例 -->
            <TabItem Header="用例">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                        <Button Content="全选" Command="{Binding SelectAllCasesCommand}" Padding="8,3" Margin="0,0,4,0" />
                        <Button Content="全不选" Command="{Binding SelectNoCasesCommand}" Padding="8,3" Margin="0,0,4,0" />
                        <TextBox MinWidth="160" Text="{Binding CaseFilter, UpdateSourceTrigger=PropertyChanged, Delay=100}" ToolTip="Filter cases" />
                        <TextBlock Text="{Binding AvailableCases.Count, StringFormat='已加载 {0} 个用例'}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding FilteredCases}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Run" Binding="{Binding IsSelected}" Width="50" />
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="结果">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <DataGrid Grid.Column="0" ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                              IsReadOnly="True" Margin="0,0,8,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Case" Binding="{Binding Name}" Width="*" />
                            <DataGridCheckBoxColumn Header="Passed" Binding="{Binding Passed}" Width="60" />
                            <DataGridTextColumn Header="Failure Reason" Binding="{Binding FailureReason}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TreeView Grid.Column="1" ItemsSource="{Binding ResultsTree}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:TestCaseNode}" ItemsSource="{Binding Steps}">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                            </HierarchicalDataTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:StepNode}" ItemsSource="{Binding Frames}">
                                <StackPanel ContextMenuOpening="StepContextMenu_Opening">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="CopyFailureDetailMenuItem" Header="复制失败详情" Click="CopyFailureDetail_Click" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Width="140" />
                                        <TextBlock Text="{Binding Status}" Width="70" />
                                        <TextBlock Text="{Binding Message}" />
                                        <!-- G6: 通道徽标（仅非空，多通道失败归属一目了然） -->
                                        <Border Background="{StaticResource RowSelected}" CornerRadius="2" Padding="3,0" Margin="4,0,0,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Channel}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Channel}" FontSize="11" Foreground="{StaticResource Accent}"/>
                                        </Border>
                                    </StackPanel>
                                    <!-- G6: Actual/Expected 行（仅失败步骤非空时显示） -->
                                    <StackPanel Orientation="Horizontal" Margin="140,2,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActualValue}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Actual:" FontSize="11" Foreground="{StaticResource TextSecondary}" Width="44"/>
                                        <TextBlock Text="{Binding ActualValue}" FontSize="11"/>
                                        <TextBlock Text="Expected:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding ExpectedValue}" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type vm:FrameNode}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CanId}" Width="70" />
                                    <TextBlock Text="{Binding DataHex}" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </TabItem>

            <TabItem Header="历史">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="尚无运行记录" Margin="12" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RunHistory.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding RunHistory}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding CompletedAtUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" MinWidth="150" />
                            <DataGridTextColumn Header="套件" Binding="{Binding SuiteName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding ErrorMessage}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="模式" Binding="{Binding Mode}" Width="100" />
                            <DataGridTextColumn Header="结果" Binding="{Binding ResultText}" Width="90" />
                            <DataGridTextColumn Header="耗时" Binding="{Binding ElapsedMs, StringFormat={}{0} ms}" Width="90" />
                            <DataGridCheckBoxColumn Header="已取消" Binding="{Binding Cancelled}" Width="70" />
                            <DataGridTemplateColumn Header="操作" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="打开报告" Command="{Binding DataContext.OpenHistoryReportCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Padding="6,2" Margin="0,0,4,0" />
                                            <Button Content="加载套件" Command="{Binding DataContext.LoadHistorySuiteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Padding="6,2" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="报告">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{Binding LatestReportPath}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"
                                   MaxWidth="280" />
                        <Button Content="在浏览器打开" Command="{Binding OpenReportCommand}"
                                HorizontalAlignment="Right" Padding="8,2" />
                    </StackPanel>
                    <!-- R1：WebView2 与 fallback 用 Grid 叠放 —— Grid 是 DockPanel last-child 占满剩余空间；
                         Border(WebView2) 填满 Grid，fallback TextBlock 覆盖其上（默认 ZIndex 更高）。不能把
                         TextBlock 放 Grid 外当 last-child（DockPanel LastChildFill 会坍缩 WebView2）。 -->
                    <Grid>
                        <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
                            <wv2:WebView2 x:Name="ReportWebView" />
                        </Border>
                        <!-- T4/MEDIUM-1/2: fallback 可见性由 code-behind UpdateReportPanel 管理（Text 绑
                             ReportError，初始 Collapsed）。不在 XAML 用 DataTrigger —— WebView2 是 HWND
                             控件，报告失败时需 Collapse WebView2 才能让 fallback 文字可见（WPF airspace）；
                             WebView2 init 错误是视图本地状态，VM 重置 ShowReportError 不影响它。 -->
                        <TextBlock x:Name="ReportFallbackText" Text="{Binding ReportError}" Foreground="{StaticResource Error}"
                                   Padding="12" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- LLM analysis result (Sprint 16) -->
        <TextBox DockPanel.Dock="Bottom" Text="{Binding AnalysisResult, Mode=OneWay}"
                 IsReadOnly="True" AcceptsReturn="True" MinHeight="80"
                 VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"
                 ToolTip="LLM failure analysis result" />
    </DockPanel>
</UserControl>


