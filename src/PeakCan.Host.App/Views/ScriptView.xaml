<UserControl x:Class="PeakCan.Host.App.Views.ScriptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:icons="clr-namespace:PeakCan.Host.App.Composition.Icons"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0" Margin="4">
            <Button Command="{Binding RunCommand}"
                    ToolTip="运行脚本 (Ctrl+Enter)"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static icons:FluentIconGlyphs.Play}"
                               FontFamily="Segoe Fluent Icons" Margin="0,0,4,0" />
                    <TextBlock Text="运行" />
                </StackPanel>
            </Button>
            <Button Command="{Binding StopCommand}"
                    ToolTip="停止正在运行的脚本"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static icons:FluentIconGlyphs.Stop}"
                               FontFamily="Segoe Fluent Icons" Margin="0,0,4,0" />
                    <TextBlock Text="停止" />
                </StackPanel>
            </Button>
            <Separator />
            <Button Command="{Binding NewCommand}"
                    ToolTip="新建脚本 (Ctrl+N)：清空编辑器并解绑当前文件"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static icons:FluentIconGlyphs.Add}"
                               FontFamily="Segoe Fluent Icons" Margin="0,0,4,0" />
                    <TextBlock Text="新建" />
                </StackPanel>
            </Button>
            <Button Command="{Binding OpenCommand}"
                    ToolTip="打开脚本文件（.js）"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static icons:FluentIconGlyphs.OpenFolder}"
                               FontFamily="Segoe Fluent Icons" Margin="0,0,4,0" />
                    <TextBlock Text="打开" />
                </StackPanel>
            </Button>
            <!-- 最近打开：与会话 MRU 分开（脚本不会出现在「文件 → 最近打开」里）。 -->
            <Menu VerticalAlignment="Center" Background="Transparent" Padding="0" Margin="4,0,0,0"
                  IsEnabled="{Binding HasRecentScripts}"
                  ToolTip="最近打开过的脚本（空列表时置灰）">
                <MenuItem Header="最近脚本" ItemsSource="{Binding RecentScripts}">
                    <MenuItem.ItemTemplate>
                        <DataTemplate>
                            <!-- 菜单弹出层不在 ScriptView 的可视祖先链上，AncestorType=Menu
                                 是本仓库已验证的写法（见 AppShell 的「最近打开」菜单）。 -->
                            <MenuItem Header="{Binding Label}"
                                      ToolTip="{Binding Path}"
                                      Command="{Binding DataContext.OpenRecentScriptCommand,
                                                        RelativeSource={RelativeSource AncestorType=Menu}}"
                                      CommandParameter="{Binding Path}" />
                        </DataTemplate>
                    </MenuItem.ItemTemplate>
                </MenuItem>
                <Separator />
                <MenuItem Header="清空最近脚本" Command="{Binding ClearRecentScriptsCommand}" />
            </Menu>
            <Button Command="{Binding SaveCommand}"
                    ToolTip="保存当前脚本 (Ctrl+S)"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static icons:FluentIconGlyphs.Save}"
                               FontFamily="Segoe Fluent Icons" Margin="0,0,4,0" />
                    <TextBlock Text="保存" />
                </StackPanel>
            </Button>
            <Button Command="{Binding SaveAsCommand}"
                    ToolTip="另存为 (Ctrl+Shift+S)"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static icons:FluentIconGlyphs.Save}"
                               FontFamily="Segoe Fluent Icons" Margin="0,0,4,0" />
                    <TextBlock Text="另存为" />
                </StackPanel>
            </Button>
            <Separator />
            <TextBlock Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       Margin="8,0"
                       Foreground="{StaticResource TextSecondary}" />
        </ToolBar>

        <!-- CodeMirror Editor -->
        <Grid Grid.Row="1" Margin="4">
            <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
                <wv2:WebView2 x:Name="EditorWebView"
                              CoreWebView2InitializationCompleted="EditorWebView_CoreWebView2InitializationCompleted" />
            </Border>

            <!-- v1.2.12 PATCH Item 7: fallback TextBlock shown when WebView2
                 init fails (e.g. missing Evergreen Runtime). Visible when
                 IsEditorReady is false (failure), collapsed when true (ok).
                 Uses IsEditorReady rather than EditorError so the trigger
                 is a clean bool comparison (WPF DataTrigger cannot match
                 non-null on a string without a converter). -->
            <TextBlock Text="{Binding EditorError}"
                       Foreground="{StaticResource Error}"
                       Padding="12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Background="#1E1E1E">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditorReady}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Output Panel -->
        <Grid Grid.Row="2" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                <TextBlock Text="输出"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <Button Content="清空"
                        Command="{Binding ClearOutputCommand}"
                        HorizontalAlignment="Right"
                        Padding="8,2" />
            </DockPanel>

            <Border Grid.Row="1"
                    BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4"
                    Background="{StaticResource ConsoleBg}">
                <ListBox ItemsSource="{Binding OutputLines}"
                         Background="Transparent"
                         Foreground="{StaticResource ConsoleFg}"
                         FontFamily="{StaticResource FontMono}"
                         FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectedIndex="-1" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
