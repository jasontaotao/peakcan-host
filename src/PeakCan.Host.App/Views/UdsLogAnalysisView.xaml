<UserControl x:Class="PeakCan.Host.App.Views.UdsLogAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:PeakCan.Host.App.Composition.Converters"
             xmlns:vm="clr-namespace:PeakCan.Host.App.ViewModels.Uds"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UdsLogAnalysisViewModel}">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button Content="打开 ASC/BLF" Command="{Binding OpenLogCommand}" Padding="6,2"/>
            <Button Content="重新分析" Command="{Binding AnalyzeCommand}" Padding="6,2" Margin="8,0,0,0"/>
            <Button Content="取消" Command="{Binding CancelCommand}" Padding="6,2" Margin="8,0,0,0"/>
            <Button Content="导出报告" Command="{Binding ExportCommand}" Padding="6,2" Margin="8,0,0,0"/>
            <Button Content="在 AI 中解读选中事务" Command="{Binding InterpretSelectedCommand}" Padding="6,2" Margin="8,0,0,0"/>
            <TextBlock Text="{Binding Status}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,6">
            <TextBlock Text="通道" VerticalAlignment="Center"/>
            <TextBox Text="{Binding ChannelText, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="4,0,8,0"/>
            <TextBlock Text="请求 ID" VerticalAlignment="Center"/>
            <TextBox Text="{Binding RequestIdText, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="4,0,8,0"/>
            <TextBlock Text="响应 ID" VerticalAlignment="Center"/>
            <TextBox Text="{Binding ResponseIdText, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="4,0,8,0"/>
            <CheckBox Content="扩展帧" IsChecked="{Binding IsExtended}" Margin="8,0,0,0"/>
            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="16,0,0,0"
                     ToolTip="按服务名/结果/NRC 过滤"/>
            <TextBlock Text="离线只读；未连接硬件；发送 0 帧"
                       Margin="16,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}"/>
        </StackPanel>

        <!-- ODX / 定义来源状态：离线页看不到在线输出日志，这里必须显式显示。 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="{Binding OdxStatusSummary}" VerticalAlignment="Center"/>
            <TextBlock Text="｜" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
            <TextBlock Text="{Binding IsOdxLoaded, StringFormat='当前报告 ODX 已加载：{0}'}"
                       VerticalAlignment="Center" Margin="4,0,0,0"/>
            <TextBlock Text="{Binding OdxReloadHint}" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource WarnText}"/>
        </StackPanel>

        <!-- 筛选无命中：与“无匹配事务”区分（spec §11.4）。 -->
        <TextBlock DockPanel.Dock="Top" Margin="0,4,0,0"
                   Text="{Binding FilterEmptyHint}"
                   Foreground="{StaticResource TextSecondary}"
                   Visibility="{Binding IsFilterEmpty, Converter={StaticResource BoolToVis}}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding VisibleTransactions}"
                      SelectedItem="{Binding SelectedTransaction}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="服务" Binding="{Binding Interpretation.ServiceDisplay}"/>
                    <DataGridTextColumn Header="结果" Binding="{Binding FinalKind}"/>
                    <DataGridTextColumn Header="pending" Binding="{Binding PendingCount}"/>
                    <DataGridTextColumn Header="NRC" Binding="{Binding FinalNrc, StringFormat=0x{0:X2}}"/>
                    <DataGridTextColumn Header="首次(ms)" Binding="{Binding FirstResponseMs, StringFormat=F3}"/>
                    <DataGridTextColumn Header="总(ms)" Binding="{Binding TotalMs, StringFormat=F3}"/>
                    <DataGridTextColumn Header="P2超限" Binding="{Binding ExceedsP2}"/>
                    <DataGridTextColumn Header="歧义" Binding="{Binding IsAmbiguous}"/>
                    <DataGridTextColumn Header="重复最终响应" Binding="{Binding HasDuplicateFinalResponse}"/>
                    <DataGridTextColumn Header="DID" Binding="{Binding Interpretation.DidName}"/>
                    <DataGridTextColumn Header="降级" Binding="{Binding Interpretation.DegradeReason}"/>
                    <DataGridTextColumn Header="未知服务" Binding="{Binding Interpretation.IsUnknownService}"/>
                </DataGrid.Columns>
            </DataGrid>

            <ScrollViewer Grid.Column="1" Margin="8,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="计数（闭合等式）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Report.Counts.Input, StringFormat='输入帧 {0}'}"/>
                <TextBlock Text="{Binding Report.Counts.MatchedDiagnostic, StringFormat='匹配诊断 {0}'}"/>
                <TextBlock Text="{Binding Report.Counts.NonDiagnostic, StringFormat='非诊断 {0}'}"/>
                <TextBlock Text="{Binding Report.Counts.Noise, StringFormat='噪声 {0}'}"/>
                <TextBlock Text="{Binding Report.Counts.UnsupportedInput, StringFormat='未支持 {0}'}"/>

                <TextBlock Text="噪声（按 CAN ID）" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <ItemsControl ItemsSource="{Binding Noise.TopIds}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="0x"/><Run Text="{Binding Id, StringFormat=X3, Mode=OneWay}"/>
                                <Run Text=" × "/><Run Text="{Binding Count, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="聚合已截断（Top-N 不是全部 ID）"
                           Foreground="{StaticResource WarnText}"
                           Visibility="{Binding Noise.AggregationTruncated, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Text="无法成帧原因" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <ItemsControl ItemsSource="{Binding Noise.Reasons}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Reason, Mode=OneWay}"/>
                                <Run Text=" × "/><Run Text="{Binding Count, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="响应校验失败 / 重复最终响应" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding Noise.ResponseValidationFailed}"/>
                <TextBlock Text="{Binding Noise.DuplicateFinalResponses}"/>
                <TextBlock Text="{Binding Report.OrphanResponses.Count, StringFormat='孤立响应 {0}'}"/>

                <TextBlock Text="选中事务解释" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <TextBlock Text="{Binding SelectedConclusion}" TextWrapping="Wrap"
                           Foreground="{StaticResource WarnText}"/>
                <TextBlock Text="{Binding SelectedTransaction.Interpretation.DidName, StringFormat='DID：{0}'}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedTransaction.Interpretation.DecodedValue, StringFormat='解码值：{0}'}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedTransaction.Interpretation.DegradeReason, StringFormat='降级原因：{0}'}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedTransaction.Interpretation.DegradeDetail, StringFormat='降级详情：{0}'}"
                           TextWrapping="Wrap"/>

                <TextBlock Text="原始证据" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <ListBox ItemsSource="{Binding SelectedEvidence}" Height="160">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="11"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
