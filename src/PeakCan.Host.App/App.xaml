<Application x:Class="PeakCan.Host.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PeakCan.Host.App"
             xmlns:conv="clr-namespace:PeakCan.Host.App.Composition.Converters"
             xmlns:flash="clr-namespace:PeakCan.Host.Core.Uds.FlashPipeline;assembly=PeakCan.Host.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>
        <!--
            v1.4.0 MINOR Task 4: registered here so any view (ReplayView +
            future VMs) can bind Visibility on a nullable string without
            re-declaring the converter locally. SendView registers
            InverseBooleanConverter inline in its own Resources block —
            keeping inverse-Boolean as a per-view resource since it is
            used only there.
        -->
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" />
        <!-- v3.2.0 MINOR: Trace Viewer legend strip + chart subplots. -->
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:OxyColorToBrushConverter x:Key="OxyColorToBrush" />
        <!-- v3.50.2 PATCH: format doubles as F2, "—" when NaN/Infinity. -->
        <conv:DoubleNanToStringConverter x:Key="DoubleNanToStr" />
        <!-- HexConverter: 双向 hex 绑定 (数值 <-> "0x{hex}" 字符串). 解决 StringFormat=0x{0:X4}
             在双向 TextBox 绑定时无法解析回源的问题 (operator 编辑后切换 step 值被重置). -->
        <conv:HexConverter x:Key="HexConverter" />
        <!-- v3.11.6 PATCH: per-source master-radio resource removed; the
             legend-strip XAML now uses MultiBinding + the singleton
             SourceIdEqualsMasterConverter instead. -->

    </Application.Resources>
</Application>
