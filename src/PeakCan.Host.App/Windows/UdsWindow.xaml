<Window x:Class="PeakCan.Host.App.Windows.UdsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PeakCan.Host.App.ViewModels.Uds"
        xmlns:views="clr-namespace:PeakCan.Host.App.Views"
        xmlns:flash="clr-namespace:PeakCan.Host.App.ViewModels.Uds.FlashPipeline"
        xmlns:core="clr-namespace:PeakCan.Host.Core.Uds.FlashPipeline;assembly=PeakCan.Host.Core"
        xmlns:conv="clr-namespace:PeakCan.Host.App.Composition.Converters"
        xmlns:icons="clr-namespace:PeakCan.Host.App.Composition.Icons"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:UdsViewModel}"
        Title="UDS 诊断"
        Width="1100" Height="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True">
    <Window.Resources>
        <!-- HexConverter 注册在 Window 级别, 所有 tab (Session/DIDs/Flashing) 都能引用.
             App.xaml 也有全局注册, 但测试不加载 App.xaml, 所以这里也要注册. -->
        <conv:HexConverter x:Key="HexConverter"/>
        <!-- 同上：刷写横幅要用布尔→可见性，测试环境没有 App.xaml 的 BoolToVis。 -->
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 刷写步骤/协议枚举的中文显示；绑定值仍是原枚举，JSON profile 契约不变。 -->
        <conv:UdsEnumDisplayConverter x:Key="UdsEnumDisplay"/>
    </Window.Resources>

    <DockPanel>
        <!-- Top: Session header strip.
             P1 防事故：刷写期间整条诊断通道（会话切换/SecurityAccess/TesterPresent/
             Load ODX）锁死——刷写走编程会话，此时任何诊断请求都会抢 ECU。 -->
        <Border DockPanel.Dock="Top" Padding="8" Background="{StaticResource SurfaceSubtle}"
                IsEnabled="{Binding IsDiagnosticsEnabled}">
            <StackPanel Orientation="Horizontal">
                <!-- 选中「日志分析」时隐藏在线控件；「加载 ODX…」保留（只影响下一次分析）。 -->
                <Button Content="默认"     Command="{Binding Session.SetDefaultSessionCommand}"   Padding="6,2" Margin="0,0,4,0"
                        Visibility="{Binding IsOnlineTab, Converter={StaticResource BoolToVis}}"/>
                <Button Content="扩展"    Command="{Binding Session.SetExtendedSessionCommand}"  Padding="6,2" Margin="0,0,4,0"
                        Visibility="{Binding IsOnlineTab, Converter={StaticResource BoolToVis}}"/>
                <Button Content="编程" Command="{Binding Session.SetProgrammingSessionCommand}" Padding="6,2" Margin="0,0,12,0"
                        Visibility="{Binding IsOnlineTab, Converter={StaticResource BoolToVis}}"/>
                <Separator/>
                <Button Content="加载 ODX…"
                        Command="{Binding LoadOdxCommand}"
                        Padding="6,2" Margin="0,0,12,0"/>
                <CheckBox Content="TesterPresent" IsChecked="{Binding Session.TesterPresentActive, Mode=OneWay}"
                          Command="{Binding Session.ToggleTesterPresentCommand}"
                          VerticalAlignment="Center" Margin="0,0,12,0"
                          Visibility="{Binding IsOnlineTab, Converter={StaticResource BoolToVis}}"/>
                <Separator/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="等级：" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding Session.SecurityLevel, Converter={StaticResource HexConverter}, ConverterParameter=2, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,4,0"/>
                    <Button Content="SecurityAccess"
                            Command="{Binding Session.SecurityAccessCommand}"
                            Padding="6,2" Margin="0,0,12,0"
                            Visibility="{Binding IsOnlineTab, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <TextBlock Text="{Binding Session.CurrentSession, StringFormat='会话：{0}'}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <!-- 与主窗口徽章同一个口径：显示**已授予**的等级，不是输入框里的请求值。 -->
                <TextBlock Text="{Binding Session.SecurityLevelText, StringFormat='安全：{0}'}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- P1 防事故：刷写锁定横幅。只禁用不说明，用户会以为界面卡了。 -->
        <Border DockPanel.Dock="Top" Padding="8,4"
                Background="{StaticResource WarnBg}"
                BorderBrush="{StaticResource WarnBorder}" BorderThickness="0,0,0,1"
                Visibility="{Binding Flash.IsFlashing, Converter={StaticResource BoolToVis}}">
            <TextBlock Foreground="{StaticResource WarnText}" TextWrapping="Wrap"
                       Text="⚠ 刷写进行中 — 诊断面板（会话 / DID / 例程 / DTC）已锁定，刷写结束后自动恢复。" />
        </Border>

        <!-- 通信参数 (只读): 诊断栈 + Flash 副栈当前生效的时序参数及其来源.
             Params 面板 500ms 轮询; 向后兼容 ctor 下为 Disabled 实例 (全部显示 —). -->
        <Expander DockPanel.Dock="Top" Header="通信参数"
                  IsExpanded="False" Padding="8,4" Background="{StaticResource SurfaceSubtle}"
                  Visibility="{Binding IsOnlineTab, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="诊断栈" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Params.DiagTransport, StringFormat='传输：{0}'}" Margin="0,1"/>
                    <TextBlock Text="{Binding Params.DiagSession, StringFormat='会话：{0}'}" Margin="0,1"/>
                    <TextBlock Text="{Binding Params.DiagP2, StringFormat='P2：{0}'}" Margin="0,1"/>
                    <TextBlock Text="{Binding Params.DiagP2Star, StringFormat='P2*：{0}'}" Margin="0,1"/>
                    <TextBlock Text="{Binding Params.DiagStMin, StringFormat='STmin：{0}'}" Margin="0,1"/>
                    <TextBlock Text="{Binding Params.DiagBlockSize, StringFormat='BS：{0}'}" Margin="0,1"/>
                    <TextBlock Text="{Binding Params.DiagNBs, StringFormat='N_Bs（等 FC 超时）：{0}'}" Margin="0,1"/>
                    <TextBlock Text="{Binding Params.DiagNCr, StringFormat='N_Cr（等 CF 超时）：{0}'}" Margin="0,1"/>
                    <TextBlock Text="{Binding Params.DiagS3Failures, StringFormat='S3 保活失败：{0}'}" Margin="0,1"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock Text="刷写副栈" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Params.FlashRunState, StringFormat='状态：{0}'}" Margin="0,1"/>
                    <TextBlock Text="{Binding Params.FlashTransport, StringFormat='传输：{0}'}" Margin="0,1"/>
                    <TextBlock Text="{Binding Params.FlashSession, StringFormat='会话：{0}'}" Margin="0,1"/>
                    <TextBlock Text="{Binding Params.FlashP2, StringFormat='P2：{0}'}" Margin="0,1"/>
                    <TextBlock Text="{Binding Params.FlashP2Star, StringFormat='P2*：{0}'}" Margin="0,1"/>
                    <TextBlock Text="{Binding Params.FlashStMin, StringFormat='STmin：{0}'}" Margin="0,1"/>
                    <TextBlock Text="{Binding Params.FlashBlockSize, StringFormat='BS：{0}'}" Margin="0,1"/>
                    <TextBlock Text="{Binding Params.FlashNBs, StringFormat='N_Bs（等 FC 超时）：{0}'}" Margin="0,1"/>
                    <TextBlock Text="{Binding Params.FlashNCr, StringFormat='N_Cr（等 CF 超时）：{0}'}" Margin="0,1"/>
                </StackPanel>
            </Grid>
        </Expander>

        <!-- Bottom: Output Log -->
        <Border DockPanel.Dock="Bottom" Padding="8" Background="{StaticResource ConsoleBg}"
                Visibility="{Binding IsOnlineTab, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="清空" HorizontalAlignment="Right"
                        Command="{Binding ClearOutputCommand}" Margin="0,0,0,4"/>
                <RichTextBox x:Name="LogBox" IsReadOnly="True" IsDocumentEnabled="True"
                             Background="{StaticResource ConsoleBg}" Foreground="{StaticResource ConsoleFg}"
                             FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto">
                    <FlowDocument PageWidth="2400">
                        <Paragraph x:Name="LogParagraph"/>
                    </FlowDocument>
                </RichTextBox>
            </DockPanel>
        </Border>

        <!-- Middle: TabControl (DIDs / Routines / DTCs / Flashing / 日志分析) -->
        <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="DID"
                     IsEnabled="{Binding IsDiagnosticsEnabled}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Did.Dids}" SelectedItem="{Binding Did.SelectedDid}"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"     Binding="{Binding Id, StringFormat=0x{0:X4}}"/>
                            <DataGridTextColumn Header="名称"   Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="长度" Binding="{Binding LengthBytes}"/>
                            <DataGridTextColumn Header="类型"   Binding="{Binding TypeDisplay}"/>
                            <DataGridTextColumn Header="读写"    Binding="{Binding WritableDisplay}"/>
                            <DataGridTextColumn Header="值"  Binding="{Binding DecodedSummary}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Column="1" Margin="12">
                        <TextBlock Text="{Binding Did.SelectedDid.Name, StringFormat='选中 DID：{0}', TargetNullValue='（未选中）'}"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding Did.SelectedDid.LengthBytes, StringFormat='长度：{0} 字节', TargetNullValue=''}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Did.SelectedDid.TypeDisplay, StringFormat='类型：{0}', TargetNullValue=''}"
                                   Margin="0,4,0,0"/>
                        <!-- v3.49.0 MINOR T5.1: 解码字段表 (Read 命中后 DidValueDecoder 产出 DecodedField[]) -->
                        <TextBlock Text="解码字段" Margin="0,8,0,2" FontWeight="Bold"/>
                        <ItemsControl ItemsSource="{Binding Did.SelectedDid.DecodedFields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PhysicalValue}"
                                                   FontFamily="Consolas" TextWrapping="Wrap" Margin="4,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Unit}"
                                                   Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="写入值（hex）" Margin="0,8,0,0"/>
                        <TextBox  Text="{Binding Did.WriteValue, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding Did.SelectedDid.Writable}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="读取"  Command="{Binding Did.ReadDidCommand}"  Padding="6,2" Margin="0,0,8,0"/>
                            <Button Content="写入" Command="{Binding Did.WriteDidCommand}" Padding="6,2"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Did.LastResult, StringFormat='最近结果：{0}'}"
                                   Margin="0,8,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="例程"
                     IsEnabled="{Binding IsDiagnosticsEnabled}">
                <DockPanel>
                    <!-- v2.0.6 PATCH Bug-4: see UdsView.xaml history. Reorder: button row docks to Top. -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
                        <Button Content="启动" Command="{Binding Routine.StartRoutineCommand}" Padding="8,3" MinWidth="72" Margin="0,0,6,0"/>
                        <Button Content="停止"  Command="{Binding Routine.StopRoutineCommand}"  Padding="8,3" MinWidth="72" Margin="0,0,6,0"/>
                        <Button Content="查询" Command="{Binding Routine.QueryRoutineCommand}" Padding="8,3" MinWidth="72" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Routine.SelectedRoutine.LastResult, StringFormat='最近结果：{0}'}"
                                   Margin="4,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Routine.Routines}" SelectedItem="{Binding Routine.SelectedRoutine}"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"     Binding="{Binding Id, StringFormat=0x{0:X4}}"/>
                            <DataGridTextColumn Header="名称"   Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay}"/>
                            <DataGridTextColumn Header="结果" Binding="{Binding LastResult}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="DTC"
                     IsEnabled="{Binding IsDiagnosticsEnabled}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
                        <Button Content="读取 DTC"  Command="{Binding Dtc.ReadDtcsCommand}" Padding="6,2"/>
                        <Button Content="清除 DTC" Command="{Binding Dtc.ClearDtcsCommand}" Padding="6,2" Margin="8,0,0,0"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Dtc.Dtcs}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="故障码"        Binding="{Binding CodeDisplay}"/>
                            <DataGridTextColumn Header="状态"      Binding="{Binding StatusDisplay}"/>
                            <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- C4 Flashing tab (4th panel). Owns the secondary flash-stack lifecycle
                 via FlashPanelViewModel. Steps bind to an ObservableCollection<FlashStep>;
                 Start/Stop drive PipelineExecutor through the per-run secondary UdsClient.
                 Programming CAN-ID hero readout (+ same-addressing warning) keeps the
                 operator aware the programming pair must differ from diagnostic 0x7E0/0x7E8.
                 Phase 2: Segment model, property panel, HEX/S19 support. -->
            <TabItem Header="刷写">
                <DockPanel>
                    <DockPanel.Resources>
                        <!-- Local copies so tests don't depend on App.xaml initialization -->
                        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
                        <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
                        <conv:NullToBooleanConverter x:Key="NullToBooleanConverter"/>
                        <conv:InverseNullToBooleanConverter x:Key="InverseNullToBooleanConverter"/>
                        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
                        <conv:NegativeToBooleanConverter x:Key="NegativeToBooleanConverter"/>
                        <conv:NonZeroToVisibilityConverter x:Key="NonZeroToVisibilityConverter"/>
                    </DockPanel.Resources>
                    <StackPanel DockPanel.Dock="Top" Margin="8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="CAN-ID:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="请求 0x" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Flash.CurrentProfile.ProgrammingCanId.RequestId, StringFormat={}{0:X3}, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,4,0"/>
                            <TextBlock Text="响应 0x" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Flash.CurrentProfile.ProgrammingCanId.ResponseId, StringFormat={}{0:X3}, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,4,0"/>
                            <TextBlock Text="功能 0x" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Flash.CurrentProfile.ProgrammingCanId.FunctionalId, StringFormat={}{0:X3}, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                            <CheckBox Content="扩展帧（29 位）"
                                      IsChecked="{Binding Flash.CurrentProfile.ProgrammingCanId.IsExtendedFrame}"
                                      VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="标准帧：11 位 CAN ID（0x000-0x7FF）。扩展帧：29 位 CAN ID。"/>
                        </StackPanel>
                        <CheckBox Content="出错时自动重启 ECU（Fail-Safe Reset）" IsChecked="{Binding Flash.CurrentProfile.AutoResetOnFailure}"
                                  Margin="0,0,0,8" ToolTip="刷写失败时自动发 ECUReset（0x01）防止 ECU 半刷状态"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="启动"  Command="{Binding Flash.StartCommand}" Padding="8,3" MinWidth="72" Margin="0,0,8,0"/>
                            <Button Content="停止"   Command="{Binding Flash.StopCommand}"  Padding="8,3" MinWidth="72" Margin="0,0,8,0"/>
                            <Button Content="保存配置" Command="{Binding Flash.SaveProfileCommand}" Padding="8,3" MinWidth="80" Margin="0,0,4,0"/>
                            <Button Content="加载配置" Command="{Binding Flash.LoadProfileCommand}" Padding="8,3" MinWidth="80" Margin="0,0,12,0"/>
                            <TextBlock VerticalAlignment="Center" FontFamily="Consolas">
                                <Run Text="状态："/><Run Text="{Binding Flash.StatusMessage, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <!-- Phase 2: Firmware Files + Flash Driver loading areas -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Firmware Files -->
                            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock DockPanel.Dock="Top" Text="固件文件：" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="添加固件文件" Padding="4,2" Margin="0,0,4,0"
                                            Command="{Binding Flash.AddFirmwareFileCommand}"
                                            ToolTip="加载 .hex / .s19 / .bin 固件文件"/>
                                    <Button Content="移除" Padding="4,2"
                                            Command="{Binding Flash.RemoveFirmwareFileCommand}"
                                            ToolTip="移除选中的固件文件"/>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Flash.CurrentProfile.FirmwareFiles}"
                                         SelectedItem="{Binding Flash.SelectedFirmwareFile, Mode=TwoWay}"
                                         Height="80" DisplayMemberPath="Path"/>
                            </DockPanel>
                            <!-- Flash Driver -->
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Top" Text="刷写驱动：" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="添加刷写驱动" Padding="4,2" Margin="0,0,4,0"
                                            Command="{Binding Flash.AddFlashDriverCommand}"
                                            ToolTip="加载刷写驱动 DLL 或二进制文件"/>
                                    <Button Content="移除" Padding="4,2"
                                            Command="{Binding Flash.RemoveFlashDriverCommand}"
                                            ToolTip="移除刷写驱动"/>
                                </StackPanel>
                                <Border Height="80" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="4">
                                    <TextBlock Text="{Binding Flash.CurrentProfile.FlashDriver.Path, TargetNullValue='（未加载驱动）'}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Border>
                            </DockPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ComboBox x:Name="KindPicker" ItemsSource="{Binding Flash.AddableKinds}"
                                      SelectedIndex="0" Width="140" Margin="0,0,4,0"
                                      ToolTip="要添加的步骤类型">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource UdsEnumDisplay}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="添加步骤" Padding="8,3" MinWidth="72" Margin="0,0,4,0"
                                    Command="{Binding Flash.AddStepCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=KindPicker}"
                                    ToolTip="追加一个所选类型的步骤"/>
                            <Button Content="移除步骤" Padding="8,3" MinWidth="80"
                                    Command="{Binding Flash.RemoveStepCommand}"
                                    ToolTip="移除选中的步骤"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="▲ 上移" Padding="8,3" MinWidth="48" Margin="0,0,4,0"
                                    Command="{Binding Flash.MoveUpCommand}"
                                    ToolTip="上移选中的步骤"/>
                            <Button Content="▼ 下移" Padding="8,3" MinWidth="48"
                                    Command="{Binding Flash.MoveDownCommand}"
                                    ToolTip="下移选中的步骤"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding Flash.ProgressPercent, Mode=OneWay}"
                                     Height="14" Minimum="0" Maximum="100" Margin="0,0,0,8"/>
                    </StackPanel>
                    <!-- Phase 2: Step list (left) + Property panel (right) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" MinWidth="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Step list -->
                        <DockPanel Grid.Column="0" Margin="0,0,8,0">
                            <ListBox ItemsSource="{Binding Flash.CurrentProfile.Steps}"
                                     SelectedItem="{Binding Flash.SelectedStep, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Kind, Converter={StaticResource UdsEnumDisplay}}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

                        <!-- Right: Property panel for selected step -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8,0,0,0">
                                <!-- Empty-state hint when no step is selected -->
                                <TextBlock Visibility="{Binding Flash.SelectedStep, Converter={StaticResource InverseNullToVisibilityConverter}}"
                                           Foreground="{StaticResource TextSecondary}" FontStyle="Italic" Margin="0,20,0,0"
                                           TextWrapping="Wrap">
                                    <Run FontFamily="Segoe Fluent Icons" FontStyle="Normal"
                                         Text="{x:Static icons:FluentIconGlyphs.ChevronLeft}"/>
                                    <Run Text=" 从左侧选择一个步骤以查看其配置"/>
                                </TextBlock>

                                <!-- Property content: only visible when a step IS selected -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="{Binding Flash.SelectedStep.Kind, Converter={StaticResource UdsEnumDisplay}, StringFormat='属性：{0}'}"
                                           FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                                <!-- AddressingMode: 0x28 (CommunicationControl) 强制 Functional (broadcast), 其余步骤可切换 -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="寻址：" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Flash.AddressingModes}"
                                              SelectedItem="{Binding Flash.SelectedStep.AddressingMode}"
                                              IsEnabled="{Binding Flash.SelectedStep.CommunicationControl, Converter={StaticResource InverseNullToBooleanConverter}}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource UdsEnumDisplay}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <!-- PreCheck properties -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep.PreCheck, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="预检查（PreCheck）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="例程 ID：" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Flash.SelectedStep.PreCheck.RoutineId, Converter={StaticResource HexConverter}, ConverterParameter=4, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- SecurityAccess properties -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep.SecurityAccess, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="安全访问（SecurityAccess）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="等级：" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Flash.SelectedStep.SecurityAccess.Level, Converter={StaticResource HexConverter}, ConverterParameter=2, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Foreground="{StaticResource Info}" VerticalAlignment="Center" Margin="4,0,0,0"
                                                   Visibility="{Binding Flash.SelectedStep.IsSecurityLevelFromOdx, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Run FontFamily="Segoe Fluent Icons" FontStyle="Normal" Text="{x:Static icons:FluentIconGlyphs.Link}"/>
                                            <Run Text=" ODX"/>
                                        </TextBlock>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="模式：" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1"
                                                  ItemsSource="{Binding Flash.SecurityAccessModes}"
                                                  SelectedItem="{Binding Flash.SelectedStep.SecurityAccess.Mode}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource UdsEnumDisplay}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="手动密钥：" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Flash.SelectedStep.SecurityAccess.ManualKeyHex, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="DLL 路径：" VerticalAlignment="Center"/>
                                        <DockPanel Grid.Row="3" Grid.Column="1">
                                            <Button Content="…" DockPanel.Dock="Right" Padding="6,0" Margin="2,0,0,0"
                                                    Command="{Binding Flash.SelectDllCommand}"/>
                                            <TextBox Text="{Binding Flash.SelectedStep.SecurityAccess.DllPath, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DockPanel>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="种子长度：" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Flash.SelectedStep.SecurityAccess.SeedLength, TargetNullValue='自动', UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Foreground="{StaticResource Info}" VerticalAlignment="Center" Margin="4,0,0,0"
                                                   Visibility="{Binding Flash.SelectedStep.IsSeedLengthFromOdx, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Run FontFamily="Segoe Fluent Icons" FontStyle="Normal" Text="{x:Static icons:FluentIconGlyphs.Link}"/>
                                            <Run Text=" ODX"/>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>

                                <!-- Erase/Verify (RoutineControl) properties -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep.RoutineControl, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="例程控制（RoutineControl）" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <!-- Issue 1: Erase 步骤的 Segment 选择器 — 选中后自动填充 StartAddr/Size -->
                                    <Grid Margin="0,0,0,8"
                                          Visibility="{Binding Flash.SelectedStep.Verify, Converter={StaticResource InverseNullToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="段：" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Flash.AllSegments}"
                                                  SelectedIndex="{Binding Flash.EraseSegmentIndex, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="选择要擦除的段（地址和大小自动获取）">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="{Binding FileName, Mode=OneWay}"/>
                                                        <Run Text=": 0x"/><Run Text="{Binding StartAddress, StringFormat={}{0:X8}, Mode=OneWay}"/>
                                                        <Run Text=" - 0x"/><Run Text="{Binding EndAddress, StringFormat={}{0:X8}, Mode=OneWay}"/>
                                                        <Run Text="（"/><Run Text="{Binding Length, Mode=OneWay}"/><Run Text=" 字节）"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="例程 ID：" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Flash.SelectedStep.RoutineControl.RoutineId, Converter={StaticResource HexConverter}, ConverterParameter=4, UpdateSourceTrigger=PropertyChanged}"/>
                                        <!-- Start Addr / Size: Verify 步骤隐藏 (从 Segment 自动算); Erase 步骤显示.
                                             选中 Segment 后自动填充 (只读), 未选时可手工编辑. -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="起始地址：" VerticalAlignment="Center"
                                                   Visibility="{Binding Flash.SelectedStep.Verify, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding Flash.SelectedStep.RoutineControl.StartAddress, Converter={StaticResource HexConverter}, ConverterParameter=8, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding Flash.SelectedStep.Verify, Converter={StaticResource InverseNullToVisibilityConverter}}"
                                                 IsEnabled="{Binding Flash.EraseSegmentIndex, Converter={StaticResource NegativeToBooleanConverter}}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="大小：" VerticalAlignment="Center"
                                                   Visibility="{Binding Flash.SelectedStep.Verify, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                 Text="{Binding Flash.SelectedStep.RoutineControl.Size, Converter={StaticResource HexConverter}, ConverterParameter=8, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding Flash.SelectedStep.Verify, Converter={StaticResource InverseNullToVisibilityConverter}}"
                                                 IsEnabled="{Binding Flash.EraseSegmentIndex, Converter={StaticResource NegativeToBooleanConverter}}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Download properties -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep.Download, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="下载传输（DownloadTransfer）" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="段：" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Flash.AllSegments}"
                                                  SelectedIndex="{Binding Flash.SelectedStep.Download.SegmentIndex}"
                                                  ToolTip="选择要下载的段（地址、大小和 CRC 自动获取）">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="{Binding FileName, Mode=OneWay}"/>
                                                        <Run Text=": 0x"/><Run Text="{Binding StartAddress, StringFormat={}{0:X8}, Mode=OneWay}"/>
                                                        <Run Text=" - 0x"/><Run Text="{Binding EndAddress, StringFormat={}{0:X8}, Mode=OneWay}"/>
                                                        <Run Text="（"/><Run Text="{Binding Length, Mode=OneWay}"/><Run Text=" 字节）"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>

                                <!-- Verify properties (CRC 预设 + Segment 绑定) -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep.Verify, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="校验（Verify）" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="段：" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Flash.AllSegments}"
                                                  SelectedIndex="{Binding Flash.SelectedStep.Verify.SegmentIndex}"
                                                  ToolTip="选择要校验的段（地址、大小和 CRC 自动获取）">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="{Binding FileName, Mode=OneWay}"/>
                                                        <Run Text=": 0x"/><Run Text="{Binding StartAddress, StringFormat={}{0:X8}, Mode=OneWay}"/>
                                                        <Run Text=" - 0x"/><Run Text="{Binding EndAddress, StringFormat={}{0:X8}, Mode=OneWay}"/>
                                                        <Run Text="（"/><Run Text="{Binding Length, Mode=OneWay}"/><Run Text=" 字节）"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="CRC 预设：" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1"
                                                  ItemsSource="{Binding Flash.CrcPresetNames}"
                                                  SelectedIndex="{Binding Flash.SelectedStep.Verify.SelectedCrcPresetIndex}"
                                                  ToolTip="选择 CRC 算法预设以匹配目标 ECU"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="多项式：" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Flash.SelectedStep.Verify.CrcParameters.Polynomial, Converter={StaticResource HexConverter}, ConverterParameter=8, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Flash.SelectedStep.Verify.IsCrcCustom}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="期望 CRC：" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Flash.SelectedStep.Verify.ExpectedChecksum, StringFormat=0x{0:X8}}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="地址：" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1">
                                            <Run Text="0x"/><Run Text="{Binding Flash.SelectedStep.Verify.StartAddress, StringFormat={}{0:X8}, Mode=OneWay}"/>
                                            <Run Text=" - 0x"/><Run Text="{Binding Flash.SelectedStep.Verify.EndAddress, StringFormat={}{0:X8}, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                    <!-- Custom CRC 参数面板 (仅在 Custom 预设时显示) -->
                                    <StackPanel Margin="0,8,0,0"
                                                Visibility="{Binding Flash.SelectedStep.Verify.IsCrcCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="自定义 CRC 参数" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="初值：" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Flash.SelectedStep.Verify.CrcParameters.Init, Converter={StaticResource HexConverter}, ConverterParameter=8, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="最终异或：" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Flash.SelectedStep.Verify.CrcParameters.FinalXor, Converter={StaticResource HexConverter}, ConverterParameter=8, UpdateSourceTrigger=PropertyChanged}"/>
                                            <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="输入反转"
                                                      IsChecked="{Binding Flash.SelectedStep.Verify.CrcParameters.ReflectInput}"
                                                      VerticalAlignment="Center"/>
                                            <CheckBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="输出反转"
                                                      IsChecked="{Binding Flash.SelectedStep.Verify.CrcParameters.ReflectOutput}"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <!-- EcuReset properties -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep.EcuReset, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="ECU 复位（ECUReset）" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="复位类型：" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding Flash.EcuResetTypes}"
                                                  SelectedItem="{Binding Flash.SelectedStep.EcuReset.ResetType}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource UdsEnumDisplay}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>

                                <!-- CommunicationControl (0x28) properties -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep.CommunicationControl, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="通信控制（CommunicationControl 0x28）" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="子功能：" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding Flash.CommunicationSubFunctions}"
                                                  SelectedItem="{Binding Flash.SelectedStep.CommunicationControl.SubFunction}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource UdsEnumDisplay}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>

                                <!-- DTCControl (0x14) properties -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep.DtcControl, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="DTC 控制（DTCControl 0x14）" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="子功能：" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding Flash.DtcControlSubFunctions}"
                                                  SelectedItem="{Binding Flash.SelectedStep.DtcControl.SubFunction}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource UdsEnumDisplay}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="DTC 组：" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Flash.SelectedStep.DtcControl.DtcGroup, Converter={StaticResource HexConverter}, ConverterParameter=6, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- DependencyCheck (编程依赖性检查) properties -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep.DependencyCheck, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="编程依赖性检查（DependencyCheck）" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="例程 ID：" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Flash.SelectedStep.DependencyCheck.RoutineId, Converter={StaticResource HexConverter}, ConverterParameter=4, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- FlashDriverDownload properties -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep.FlashDriverDownload, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="刷写驱动下载（FlashDriverDownload）" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <TextBlock Text="将刷写驱动下载到 ECU RAM，由 ECU 自动执行擦写操作" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                    <StackPanel Margin="0,8,0,0"
                                                Visibility="{Binding Flash.FlashDriverSegmentCount, Converter={StaticResource NonZeroToVisibilityConverter}}">
                                        <TextBlock Text="驱动段：" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding Flash.FlashDriverSegments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,0,0,2">
                                                        <Run Text="{Binding FileName, Mode=OneWay}"/>
                                                        <Run Text=": 0x"/><Run Text="{Binding StartAddress, StringFormat={}{0:X8}, Mode=OneWay}"/>
                                                        <Run Text=" - 0x"/><Run Text="{Binding EndAddress, StringFormat={}{0:X8}, Mode=OneWay}"/>
                                                        <Run Text="（"/><Run Text="{Binding Length, Mode=OneWay}"/><Run Text=" 字节）"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Show "no properties" when all groups are null (e.g. PreCheck, SessionControl) -->
                                <TextBlock Text="（此步骤类型无可配置属性）"
                                           Foreground="{StaticResource TextSecondary}" FontStyle="Italic" Margin="0,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Flash.SelectedStep.SecurityAccess}" Value="{x:Null}"/>
                                                        <Condition Binding="{Binding Flash.SelectedStep.RoutineControl}" Value="{x:Null}"/>
                                                        <Condition Binding="{Binding Flash.SelectedStep.Download}" Value="{x:Null}"/>
                                                        <Condition Binding="{Binding Flash.SelectedStep.Verify}" Value="{x:Null}"/>
                                                        <Condition Binding="{Binding Flash.SelectedStep.EcuReset}" Value="{x:Null}"/>
                                                        <Condition Binding="{Binding Flash.SelectedStep.CommunicationControl}" Value="{x:Null}"/>
                                                        <Condition Binding="{Binding Flash.SelectedStep.DtcControl}" Value="{x:Null}"/>
                                                        <Condition Binding="{Binding Flash.SelectedStep.DependencyCheck}" Value="{x:Null}"/>
                                                        <Condition Binding="{Binding Flash.SelectedStep.FlashDriverDownload}" Value="{x:Null}"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                </StackPanel><!-- end of inner StackPanel for selected-step properties -->
                            </StackPanel><!-- end of outer StackPanel -->
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- 离线日志分析页签：只读解析 ASC/BLF，不接触硬件；在线控件在选中本页时隐藏。 -->
            <TabItem Header="日志分析">
                <views:UdsLogAnalysisView DataContext="{Binding LogAnalysis}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
