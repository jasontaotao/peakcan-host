<Window x:Class="PeakCan.Host.App.Windows.UdsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PeakCan.Host.App.ViewModels.Uds"
        xmlns:flash="clr-namespace:PeakCan.Host.App.ViewModels.Uds.FlashPipeline"
        xmlns:core="clr-namespace:PeakCan.HIL.Core.Uds.FlashPipeline;assembly=PeakCan.HIL.Core"
        xmlns:conv="clr-namespace:PeakCan.Host.App.Composition.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:UdsViewModel}"
        Title="UDS Diagnostics"
        Width="1100" Height="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True">
    <Window.Resources>
        <!-- HexConverter 注册在 Window 级别, 所有 tab (Session/DIDs/Flashing) 都能引用.
             App.xaml 也有全局注册, 但测试不加载 App.xaml, 所以这里也要注册. -->
        <conv:HexConverter x:Key="HexConverter"/>
    </Window.Resources>

    <DockPanel>
        <!-- Top: Session header strip -->
        <Border DockPanel.Dock="Top" Padding="8" Background="#F0F0F0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Default"     Command="{Binding Session.SetDefaultSessionCommand}"   Padding="6,2" Margin="0,0,4,0"/>
                <Button Content="Extended"    Command="{Binding Session.SetExtendedSessionCommand}"  Padding="6,2" Margin="0,0,4,0"/>
                <Button Content="Programming" Command="{Binding Session.SetProgrammingSessionCommand}" Padding="6,2" Margin="0,0,12,0"/>
                <Separator/>
                <Button Content="Load ODX…"
                        Command="{Binding LoadOdxCommand}"
                        Padding="6,2" Margin="0,0,12,0"/>
                <CheckBox Content="TesterPresent" IsChecked="{Binding Session.TesterPresentActive, Mode=OneWay}"
                          Command="{Binding Session.ToggleTesterPresentCommand}"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Separator/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Level:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding Session.SecurityLevel, Converter={StaticResource HexConverter}, ConverterParameter=2, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,4,0"/>
                    <Button Content="SecurityAccess"
                            Command="{Binding Session.SecurityAccessCommand}"
                            Padding="6,2" Margin="0,0,12,0"/>
                </StackPanel>
                <TextBlock Text="{Binding Session.CurrentSession, StringFormat='Session: {0}'}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding Session.SecurityLevel, StringFormat='Level: 0x{0:X2}', TargetNullValue='(not authenticated)'}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Bottom: Output Log -->
        <Border DockPanel.Dock="Bottom" Padding="8" Background="#1E1E1E">
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="Clear" HorizontalAlignment="Right"
                        Command="{Binding ClearOutputCommand}" Margin="0,0,0,4"/>
                <RichTextBox x:Name="LogBox" IsReadOnly="True" IsDocumentEnabled="True"
                             Background="#1E1E1E" Foreground="#D4D4D4"
                             FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto">
                    <FlowDocument PageWidth="2400">
                        <Paragraph x:Name="LogParagraph"/>
                    </FlowDocument>
                </RichTextBox>
            </DockPanel>
        </Border>

        <!-- Middle: TabControl (DIDs / Routines / DTCs) -->
        <TabControl>
            <TabItem Header="DIDs">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Did.Dids}" SelectedItem="{Binding Did.SelectedDid}"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"     Binding="{Binding Id, StringFormat=0x{0:X4}}"/>
                            <DataGridTextColumn Header="Name"   Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Length" Binding="{Binding LengthBytes}"/>
                            <DataGridTextColumn Header="Type"   Binding="{Binding TypeDisplay}"/>
                            <DataGridTextColumn Header="R/W"    Binding="{Binding WritableDisplay}"/>
                            <DataGridTextColumn Header="Value"  Binding="{Binding DecodedSummary}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Column="1" Margin="12">
                        <TextBlock Text="{Binding Did.SelectedDid.Name, StringFormat='Selected DID: {0}', TargetNullValue='(none selected)'}"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding Did.SelectedDid.LengthBytes, StringFormat='Length: {0} bytes', TargetNullValue=''}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Did.SelectedDid.TypeDisplay, StringFormat='Type: {0}', TargetNullValue=''}"
                                   Margin="0,4,0,0"/>
                        <!-- v3.49.0 MINOR T5.1: 解码字段表 (Read 命中后 DidValueDecoder 产出 DecodedField[]) -->
                        <TextBlock Text="Decoded fields" Margin="0,8,0,2" FontWeight="Bold"/>
                        <ItemsControl ItemsSource="{Binding Did.SelectedDid.DecodedFields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PhysicalValue}"
                                                   FontFamily="Consolas" TextWrapping="Wrap" Margin="4,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Unit}"
                                                   Foreground="Gray" Margin="4,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Write value (hex)" Margin="0,8,0,0"/>
                        <TextBox  Text="{Binding Did.WriteValue, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding Did.SelectedDid.Writable}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Read"  Command="{Binding Did.ReadDidCommand}"  Padding="6,2" Margin="0,0,8,0"/>
                            <Button Content="Write" Command="{Binding Did.WriteDidCommand}" Padding="6,2"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Did.LastResult, StringFormat='Last: {0}'}"
                                   Margin="0,8,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Routines">
                <DockPanel>
                    <!-- v2.0.6 PATCH Bug-4: see UdsView.xaml history. Reorder: button row docks to Top. -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
                        <Button Content="Start" Command="{Binding Routine.StartRoutineCommand}" Padding="8,3" MinWidth="72" Margin="0,0,6,0"/>
                        <Button Content="Stop"  Command="{Binding Routine.StopRoutineCommand}"  Padding="8,3" MinWidth="72" Margin="0,0,6,0"/>
                        <Button Content="Query" Command="{Binding Routine.QueryRoutineCommand}" Padding="8,3" MinWidth="72" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Routine.SelectedRoutine.LastResult, StringFormat='Last: {0}'}"
                                   Margin="4,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Routine.Routines}" SelectedItem="{Binding Routine.SelectedRoutine}"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"     Binding="{Binding Id, StringFormat=0x{0:X4}}"/>
                            <DataGridTextColumn Header="Name"   Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
                            <DataGridTextColumn Header="Result" Binding="{Binding LastResult}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="DTCs">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
                        <Button Content="Read DTCs"  Command="{Binding Dtc.ReadDtcsCommand}" Padding="6,2"/>
                        <Button Content="Clear DTCs" Command="{Binding Dtc.ClearDtcsCommand}" Padding="6,2" Margin="8,0,0,0"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Dtc.Dtcs}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code"        Binding="{Binding CodeDisplay}"/>
                            <DataGridTextColumn Header="Status"      Binding="{Binding StatusDisplay}"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- C4 Flashing tab (4th panel). Owns the secondary flash-stack lifecycle
                 via FlashPanelViewModel. Steps bind to an ObservableCollection<FlashStep>;
                 Start/Stop drive PipelineExecutor through the per-run secondary UdsClient.
                 Programming CAN-ID hero readout (+ same-addressing warning) keeps the
                 operator aware the programming pair must differ from diagnostic 0x7E0/0x7E8.
                 Phase 2: Segment model, property panel, HEX/S19 support. -->
            <TabItem Header="Flashing">
                <DockPanel>
                    <DockPanel.Resources>
                        <!-- Local copies so tests don't depend on App.xaml initialization -->
                        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
                        <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
                        <conv:NullToBooleanConverter x:Key="NullToBooleanConverter"/>
                        <conv:InverseNullToBooleanConverter x:Key="InverseNullToBooleanConverter"/>
                        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
                        <conv:NegativeToBooleanConverter x:Key="NegativeToBooleanConverter"/>
                        <conv:NonZeroToVisibilityConverter x:Key="NonZeroToVisibilityConverter"/>
                    </DockPanel.Resources>
                    <StackPanel DockPanel.Dock="Top" Margin="8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="CAN-ID:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Req 0x" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Flash.CurrentProfile.ProgrammingCanId.RequestId, StringFormat={}{0:X3}, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,4,0"/>
                            <TextBlock Text="Resp 0x" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Flash.CurrentProfile.ProgrammingCanId.ResponseId, StringFormat={}{0:X3}, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,4,0"/>
                            <TextBlock Text="Func 0x" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Flash.CurrentProfile.ProgrammingCanId.FunctionalId, StringFormat={}{0:X3}, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                            <CheckBox Content="Extended Frame (29-bit)"
                                      IsChecked="{Binding Flash.CurrentProfile.ProgrammingCanId.IsExtendedFrame}"
                                      VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="Standard frame: 11-bit CAN ID (0x000-0x7FF). Extended frame: 29-bit CAN ID."/>
                        </StackPanel>
                        <CheckBox Content="出错时自动重启 ECU (Fail-Safe Reset)" IsChecked="{Binding Flash.CurrentProfile.AutoResetOnFailure}"
                                  Margin="0,0,0,8" ToolTip="刷写失败时自动发 EcuReset(0x01) 防止 ECU 半刷状态"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Start"  Command="{Binding Flash.StartCommand}" Padding="8,3" MinWidth="72" Margin="0,0,8,0"/>
                            <Button Content="Stop"   Command="{Binding Flash.StopCommand}"  Padding="8,3" MinWidth="72" Margin="0,0,8,0"/>
                            <Button Content="Save Profile" Command="{Binding Flash.SaveProfileCommand}" Padding="8,3" MinWidth="80" Margin="0,0,4,0"/>
                            <Button Content="Load Profile" Command="{Binding Flash.LoadProfileCommand}" Padding="8,3" MinWidth="80" Margin="0,0,12,0"/>
                            <TextBlock VerticalAlignment="Center" FontFamily="Consolas">
                                <Run Text="Status: "/><Run Text="{Binding Flash.StatusMessage, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <!-- Phase 2: Firmware Files + Flash Driver loading areas -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Firmware Files -->
                            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock DockPanel.Dock="Top" Text="Firmware Files:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="+ Add Firmware File" Padding="4,2" Margin="0,0,4,0"
                                            Command="{Binding Flash.AddFirmwareFileCommand}"
                                            ToolTip="Load a .hex / .s19 / .bin firmware file"/>
                                    <Button Content="- Remove" Padding="4,2"
                                            Command="{Binding Flash.RemoveFirmwareFileCommand}"
                                            ToolTip="Remove selected firmware file"/>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Flash.CurrentProfile.FirmwareFiles}"
                                         SelectedItem="{Binding Flash.SelectedFirmwareFile, Mode=TwoWay}"
                                         Height="80" DisplayMemberPath="Path"/>
                            </DockPanel>
                            <!-- Flash Driver -->
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Top" Text="Flash Driver:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="+ Add Flash Driver" Padding="4,2" Margin="0,0,4,0"
                                            Command="{Binding Flash.AddFlashDriverCommand}"
                                            ToolTip="Load a flash driver DLL or binary"/>
                                    <Button Content="- Remove" Padding="4,2"
                                            Command="{Binding Flash.RemoveFlashDriverCommand}"
                                            ToolTip="Remove flash driver"/>
                                </StackPanel>
                                <Border Height="80" BorderBrush="#CCC" BorderThickness="1" Padding="4">
                                    <TextBlock Text="{Binding Flash.CurrentProfile.FlashDriver.Path, TargetNullValue='(no driver loaded)'}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Border>
                            </DockPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ComboBox x:Name="KindPicker" ItemsSource="{Binding Flash.AddableKinds}"
                                      SelectedIndex="0" Width="140" Margin="0,0,4,0"
                                      ToolTip="Step kind to add"/>
                            <Button Content="Add Step" Padding="8,3" MinWidth="72" Margin="0,0,4,0"
                                    Command="{Binding Flash.AddStepCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=KindPicker}"
                                    ToolTip="Append a new step of the selected kind"/>
                            <Button Content="Remove Step" Padding="8,3" MinWidth="80"
                                    Command="{Binding Flash.RemoveStepCommand}"
                                    ToolTip="Remove the selected step"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="▲ Up" Padding="8,3" MinWidth="48" Margin="0,0,4,0"
                                    Command="{Binding Flash.MoveUpCommand}"
                                    ToolTip="Move selected step up"/>
                            <Button Content="▼ Down" Padding="8,3" MinWidth="48"
                                    Command="{Binding Flash.MoveDownCommand}"
                                    ToolTip="Move selected step down"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding Flash.ProgressPercent, Mode=OneWay}"
                                     Height="14" Minimum="0" Maximum="100" Margin="0,0,0,8"/>
                    </StackPanel>
                    <!-- Phase 2: Step list (left) + Property panel (right) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" MinWidth="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Step list -->
                        <DockPanel Grid.Column="0" Margin="0,0,8,0">
                            <ListBox ItemsSource="{Binding Flash.CurrentProfile.Steps}"
                                     SelectedItem="{Binding Flash.SelectedStep, Mode=TwoWay}"
                                     DisplayMemberPath="Kind"/>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

                        <!-- Right: Property panel for selected step -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8,0,0,0">
                                <!-- Empty-state hint when no step is selected -->
                                <TextBlock Text="← 从左侧选择一个步骤以查看其配置"
                                           Visibility="{Binding Flash.SelectedStep, Converter={StaticResource InverseNullToVisibilityConverter}}"
                                           Foreground="Gray" FontStyle="Italic" Margin="0,20,0,0"
                                           TextWrapping="Wrap"/>

                                <!-- Property content: only visible when a step IS selected -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="{Binding Flash.SelectedStep.Kind, StringFormat='Properties: {0}'}"
                                           FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                                <!-- AddressingMode: 0x28 (CommunicationControl) 强制 Functional (broadcast), 其余步骤可切换 -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Addressing:" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Flash.AddressingModes}"
                                              SelectedItem="{Binding Flash.SelectedStep.AddressingMode}"
                                              IsEnabled="{Binding Flash.SelectedStep.CommunicationControl, Converter={StaticResource InverseNullToBooleanConverter}}"
                                              />
                                </Grid>

                                <!-- PreCheck properties -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep.PreCheck, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="PreCheck" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Routine ID:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Flash.SelectedStep.PreCheck.RoutineId, Converter={StaticResource HexConverter}, ConverterParameter=4, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- SecurityAccess properties -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep.SecurityAccess, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="SecurityAccess" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Level:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Flash.SelectedStep.SecurityAccess.Level, Converter={StaticResource HexConverter}, ConverterParameter=2, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="🔗 ODX" Foreground="SteelBlue" VerticalAlignment="Center" Margin="4,0,0,0"
                                                   Visibility="{Binding Flash.SelectedStep.IsSecurityLevelFromOdx, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Mode:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1"
                                                  ItemsSource="{Binding Flash.SecurityAccessModes}"
                                                  SelectedItem="{Binding Flash.SelectedStep.SecurityAccess.Mode}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Manual Key:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Flash.SelectedStep.SecurityAccess.ManualKeyHex, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="DLL Path:" VerticalAlignment="Center"/>
                                        <DockPanel Grid.Row="3" Grid.Column="1">
                                            <Button Content="…" DockPanel.Dock="Right" Padding="6,0" Margin="2,0,0,0"
                                                    Command="{Binding Flash.SelectDllCommand}"/>
                                            <TextBox Text="{Binding Flash.SelectedStep.SecurityAccess.DllPath, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DockPanel>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Seed Length:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Flash.SelectedStep.SecurityAccess.SeedLength, TargetNullValue='auto', UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="🔗 ODX" Foreground="SteelBlue" VerticalAlignment="Center" Margin="4,0,0,0"
                                                   Visibility="{Binding Flash.SelectedStep.IsSeedLengthFromOdx, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Erase/Verify (RoutineControl) properties -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep.RoutineControl, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="RoutineControl" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <!-- Issue 1: Erase 步骤的 Segment 选择器 — 选中后自动填充 StartAddr/Size -->
                                    <Grid Margin="0,0,0,8"
                                          Visibility="{Binding Flash.SelectedStep.Verify, Converter={StaticResource InverseNullToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Segment:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Flash.AllSegments}"
                                                  SelectedIndex="{Binding Flash.EraseSegmentIndex, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="选择要擦除的 Segment (地址+大小自动获取)">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="{Binding FileName, Mode=OneWay}"/>
                                                        <Run Text=": 0x"/><Run Text="{Binding StartAddress, StringFormat={}{0:X8}, Mode=OneWay}"/>
                                                        <Run Text=" - 0x"/><Run Text="{Binding EndAddress, StringFormat={}{0:X8}, Mode=OneWay}"/>
                                                        <Run Text=" ("/><Run Text="{Binding Length, Mode=OneWay}"/><Run Text=" B)"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Routine ID:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Flash.SelectedStep.RoutineControl.RoutineId, Converter={StaticResource HexConverter}, ConverterParameter=4, UpdateSourceTrigger=PropertyChanged}"/>
                                        <!-- Start Addr / Size: Verify 步骤隐藏 (从 Segment 自动算); Erase 步骤显示.
                                             选中 Segment 后自动填充 (只读), 未选时可手工编辑. -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Start Addr:" VerticalAlignment="Center"
                                                   Visibility="{Binding Flash.SelectedStep.Verify, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding Flash.SelectedStep.RoutineControl.StartAddress, Converter={StaticResource HexConverter}, ConverterParameter=8, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding Flash.SelectedStep.Verify, Converter={StaticResource InverseNullToVisibilityConverter}}"
                                                 IsEnabled="{Binding Flash.EraseSegmentIndex, Converter={StaticResource NegativeToBooleanConverter}}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Size:" VerticalAlignment="Center"
                                                   Visibility="{Binding Flash.SelectedStep.Verify, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                 Text="{Binding Flash.SelectedStep.RoutineControl.Size, Converter={StaticResource HexConverter}, ConverterParameter=8, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding Flash.SelectedStep.Verify, Converter={StaticResource InverseNullToVisibilityConverter}}"
                                                 IsEnabled="{Binding Flash.EraseSegmentIndex, Converter={StaticResource NegativeToBooleanConverter}}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Download properties -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep.Download, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Download" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Segment:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Flash.AllSegments}"
                                                  SelectedIndex="{Binding Flash.SelectedStep.Download.SegmentIndex}"
                                                  ToolTip="选择要下载的 Segment (地址+大小+CRC 自动获取)">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="{Binding FileName, Mode=OneWay}"/>
                                                        <Run Text=": 0x"/><Run Text="{Binding StartAddress, StringFormat={}{0:X8}, Mode=OneWay}"/>
                                                        <Run Text=" - 0x"/><Run Text="{Binding EndAddress, StringFormat={}{0:X8}, Mode=OneWay}"/>
                                                        <Run Text=" ("/><Run Text="{Binding Length, Mode=OneWay}"/><Run Text=" B)"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>

                                <!-- Verify properties (CRC 预设 + Segment 绑定) -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep.Verify, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Verify" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Segment:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Flash.AllSegments}"
                                                  SelectedIndex="{Binding Flash.SelectedStep.Verify.SegmentIndex}"
                                                  ToolTip="选择要校验的 Segment (地址+大小+CRC 自动获取)">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="{Binding FileName, Mode=OneWay}"/>
                                                        <Run Text=": 0x"/><Run Text="{Binding StartAddress, StringFormat={}{0:X8}, Mode=OneWay}"/>
                                                        <Run Text=" - 0x"/><Run Text="{Binding EndAddress, StringFormat={}{0:X8}, Mode=OneWay}"/>
                                                        <Run Text=" ("/><Run Text="{Binding Length, Mode=OneWay}"/><Run Text=" B)"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="CRC Preset:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1"
                                                  ItemsSource="{Binding Flash.CrcPresetNames}"
                                                  SelectedIndex="{Binding Flash.SelectedStep.Verify.SelectedCrcPresetIndex}"
                                                  ToolTip="选择 CRC 算法预设以匹配目标 ECU"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Polynomial:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Flash.SelectedStep.Verify.CrcParameters.Polynomial, Converter={StaticResource HexConverter}, ConverterParameter=8, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Flash.SelectedStep.Verify.IsCrcCustom}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Expected CRC:" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Flash.SelectedStep.Verify.ExpectedChecksum, StringFormat=0x{0:X8}}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Address:" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1">
                                            <Run Text="0x"/><Run Text="{Binding Flash.SelectedStep.Verify.StartAddress, StringFormat={}{0:X8}, Mode=OneWay}"/>
                                            <Run Text=" - 0x"/><Run Text="{Binding Flash.SelectedStep.Verify.EndAddress, StringFormat={}{0:X8}, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                    <!-- Custom CRC 参数面板 (仅在 Custom 预设时显示) -->
                                    <StackPanel Margin="0,8,0,0"
                                                Visibility="{Binding Flash.SelectedStep.Verify.IsCrcCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Custom CRC Parameters" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Init:" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Flash.SelectedStep.Verify.CrcParameters.Init, Converter={StaticResource HexConverter}, ConverterParameter=8, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Final XOR:" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Flash.SelectedStep.Verify.CrcParameters.FinalXor, Converter={StaticResource HexConverter}, ConverterParameter=8, UpdateSourceTrigger=PropertyChanged}"/>
                                            <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Reflect Input"
                                                      IsChecked="{Binding Flash.SelectedStep.Verify.CrcParameters.ReflectInput}"
                                                      VerticalAlignment="Center"/>
                                            <CheckBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="Reflect Output"
                                                      IsChecked="{Binding Flash.SelectedStep.Verify.CrcParameters.ReflectOutput}"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <!-- EcuReset properties -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep.EcuReset, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="EcuReset" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Reset Type:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding Flash.EcuResetTypes}"
                                                  SelectedItem="{Binding Flash.SelectedStep.EcuReset.ResetType}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- CommunicationControl (0x28) properties -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep.CommunicationControl, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="CommunicationControl (0x28)" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sub-function:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding Flash.CommunicationSubFunctions}"
                                                  SelectedItem="{Binding Flash.SelectedStep.CommunicationControl.SubFunction}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- DTCControl (0x14) properties -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep.DtcControl, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="DTCControl (0x14)" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sub-function:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding Flash.DtcControlSubFunctions}"
                                                  SelectedItem="{Binding Flash.SelectedStep.DtcControl.SubFunction}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="DTC Group:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Flash.SelectedStep.DtcControl.DtcGroup, Converter={StaticResource HexConverter}, ConverterParameter=6, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- DependencyCheck (编程依赖性检查) properties -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep.DependencyCheck, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="DependencyCheck (编程依赖性检查)" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Routine ID:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Flash.SelectedStep.DependencyCheck.RoutineId, Converter={StaticResource HexConverter}, ConverterParameter=4, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- FlashDriverDownload properties -->
                                <StackPanel Visibility="{Binding Flash.SelectedStep.FlashDriverDownload, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="FlashDriverDownload" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <TextBlock Text="将 flash driver 下载到 ECU RAM, ECU 自动执行擦写操作" Foreground="Gray" TextWrapping="Wrap"/>
                                    <StackPanel Margin="0,8,0,0"
                                                Visibility="{Binding Flash.FlashDriverSegmentCount, Converter={StaticResource NonZeroToVisibilityConverter}}">
                                        <TextBlock Text="Driver Segments:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding Flash.FlashDriverSegments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,0,0,2">
                                                        <Run Text="{Binding FileName, Mode=OneWay}"/>
                                                        <Run Text=": 0x"/><Run Text="{Binding StartAddress, StringFormat={}{0:X8}, Mode=OneWay}"/>
                                                        <Run Text=" - 0x"/><Run Text="{Binding EndAddress, StringFormat={}{0:X8}, Mode=OneWay}"/>
                                                        <Run Text=" ("/><Run Text="{Binding Length, Mode=OneWay}"/><Run Text=" B)"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Show "no properties" when all groups are null (e.g. PreCheck, SessionControl) -->
                                <TextBlock Text="(No configurable properties for this step kind)"
                                           Foreground="Gray" FontStyle="Italic" Margin="0,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Flash.SelectedStep.SecurityAccess}" Value="{x:Null}"/>
                                                        <Condition Binding="{Binding Flash.SelectedStep.RoutineControl}" Value="{x:Null}"/>
                                                        <Condition Binding="{Binding Flash.SelectedStep.Download}" Value="{x:Null}"/>
                                                        <Condition Binding="{Binding Flash.SelectedStep.Verify}" Value="{x:Null}"/>
                                                        <Condition Binding="{Binding Flash.SelectedStep.EcuReset}" Value="{x:Null}"/>
                                                        <Condition Binding="{Binding Flash.SelectedStep.CommunicationControl}" Value="{x:Null}"/>
                                                        <Condition Binding="{Binding Flash.SelectedStep.DtcControl}" Value="{x:Null}"/>
                                                        <Condition Binding="{Binding Flash.SelectedStep.DependencyCheck}" Value="{x:Null}"/>
                                                        <Condition Binding="{Binding Flash.SelectedStep.FlashDriverDownload}" Value="{x:Null}"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                </StackPanel><!-- end of inner StackPanel for selected-step properties -->
                            </StackPanel><!-- end of outer StackPanel -->
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
