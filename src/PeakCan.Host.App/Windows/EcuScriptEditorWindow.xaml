<Window x:Class="PeakCan.Host.App.Windows.EcuScriptEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:PeakCan.Host.App.Composition.Icons"
        Title="{Binding WindowTitle}" Width="900" Height="600"
        WindowStartupLocation="CenterOwner">
  <DockPanel>
    <!-- 工具栏：StackPanel + Button（贴合项目现有按钮风格） -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
      <Button Command="{Binding OpenCommand}" Margin="0,0,4,0" Padding="8,3">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{x:Static icons:FluentIconGlyphs.OpenFolder}"
                     FontFamily="Segoe Fluent Icons" Margin="0,0,4,0" />
          <TextBlock Text="Open" />
        </StackPanel>
      </Button>
      <Button Command="{Binding SaveCommand}" Margin="0,0,4,0" Padding="8,3">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{x:Static icons:FluentIconGlyphs.Save}"
                     FontFamily="Segoe Fluent Icons" Margin="0,0,4,0" />
          <TextBlock Text="Save" />
        </StackPanel>
      </Button>
      <Button Content="Save As..." Command="{Binding SaveAsCommand}" Margin="0,0,4,0" Padding="8,3" />
      <Button Command="{Binding FormatCommand}" Margin="0,0,4,0" Padding="8,3">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{x:Static icons:FluentIconGlyphs.Sparkle}"
                     FontFamily="Segoe Fluent Icons" Margin="0,0,4,0" />
          <TextBlock Text="Format" />
        </StackPanel>
      </Button>
      <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0" />
    </StackPanel>
    <!-- 错误条 -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Margin="4">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Error}" TextWrapping="Wrap" />
    </Border>
    <!-- 编辑区：Consolas 等宽、多行、横向/纵向滚动、PropertyChanged 即时回写 -->
    <TextBox Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}"
             AcceptsReturn="True" TextWrapping="NoWrap"
             FontFamily="Cascadia Mono, Consolas"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             Padding="4" Margin="4" />
  </DockPanel>
</Window>
