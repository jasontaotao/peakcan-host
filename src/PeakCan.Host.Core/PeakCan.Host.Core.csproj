<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- Restbus unification M1: prefer a sibling-repo project reference, else the NuGet package.
       The sibling path resolves only when the two repos sit next to each other on disk (dev box:
       D:\claude_proj2\{peakcan-host,peakcan-hil-core}); on CI the Exists() condition is FALSE and
       the PackageReference branch is used. CI gets the package from the local feed it fills in
       .github/workflows/ci.yml ("Build + pack hil-core into local feed"), which packs hil-core's
       DEFAULT branch — so Directory.Packages.props' pinned version MUST match that branch (a
       lockstep guard step in ci.yml fails the run if it does not). -->
  <ItemGroup Condition="Exists('..\..\..\peakcan-hil-core\src\PeakCan.HIL.Core\PeakCan.HIL.Core.csproj')">
    <ProjectReference Include="..\..\..\peakcan-hil-core\src\PeakCan.HIL.Core\PeakCan.HIL.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\..\peakcan-hil-core\src\PeakCan.HIL.Core\PeakCan.HIL.Core.csproj')">
    <PackageReference Include="PeakCan.HIL.Core" />
  </ItemGroup>

  <!-- S2-T5: ASAP2 consumption (XCP capability reconciliation in Core/Xcp). Same dual-pin
       pattern as PeakCan.HIL.Core above: sibling-repo project reference when the repos sit
       next to each other (D:\claude_proj2\{peakcan-host,a2l-editor}), else the pinned
       PeakCan.ASAP2 0.1.1 package from the local feed (CI: packed in ci.yml, see S2-T17).
       A2lEditor.Core targets netstandard2.1, which is consumable from this net10.0 project. -->
  <ItemGroup Condition="Exists('..\..\..\a2l-editor\src\A2lEditor.Core\A2lEditor.Core.csproj')">
    <ProjectReference Include="..\..\..\a2l-editor\src\A2lEditor.Core\A2lEditor.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\..\a2l-editor\src\A2lEditor.Core\A2lEditor.Core.csproj')">
    <PackageReference Include="PeakCan.ASAP2" />
  </ItemGroup>

</Project>
