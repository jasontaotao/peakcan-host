<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PeakCan.Host.Mobile.Views.AnchorValuesPage"
             Title="锚点信号值">
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="8">
        <Label x:Name="TitleLabel" Grid.Row="0" FontAttributes="Bold" FontFamily="Mono" FontSize="14" />
        <CollectionView Grid.Row="1" ItemsSource="{Binding Rows}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="0,2">
                        <Label Grid.Column="0" Text="{Binding MessageName, StringFormat='{0}.{SignalName}'}"
                               FontFamily="Mono" FontSize="12" LineBreakMode="TailTruncation" />
                        <Label Grid.Column="1" Text="{Binding ValueText}" FontFamily="Mono" FontSize="12" />
                        <Label Grid.Column="2" Text="{Binding Unit}" FontFamily="Mono" FontSize="12" TextColor="Gray" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="该区域尚未缓存" HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>