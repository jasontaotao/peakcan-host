<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="PeakCan.Host.Mobile.Views.TracePage"
             Title="Trace">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" Padding="8" RowSpacing="4">
        <Grid x:Name="ControlsRow" Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button Text="{Binding PlayPauseLabel}" Clicked="OnTogglePlay" WidthRequest="60" />
            <Picker Grid.Column="1" x:Name="SpeedPicker" SelectedIndexChanged="OnSpeedChanged" WidthRequest="80" />
            <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="4">
                    <Label Text="{Binding CurrentTimeText}" VerticalOptions="Center" />
                    <Label Text="/" VerticalOptions="Center" />
                    <Label Text="{Binding DurationText}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="{Binding DurationScanProgress, StringFormat='扫描 {0:P0}'}" FontSize="12" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
            <Button Grid.Column="3" Text="DBC" Clicked="OnLoadDbcClicked" />
        </Grid>

        <Label x:Name="DbcStatusRow" Grid.Row="1" Text="{Binding DbcStatusText}" FontSize="12" LineBreakMode="TailTruncation" />

        <!-- Slider: NO Value binding; code-behind syncs one-way to avoid drag fighting -->
        <Slider x:Name="SeekSlider" Grid.Row="2" Minimum="0" Maximum="1"
                DragStarted="OnSeekStarted" DragCompleted="OnSeekCompleted"
                IsEnabled="{Binding DurationKnown}" />

        <Grid x:Name="FramesGrid" Grid.Row="3">
            <CollectionView x:Name="Frames" ItemsSource="{Binding VisibleRows}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="8" Padding="0,2">
                        <Label Grid.Column="0" Text="{Binding TimeText}" FontFamily="Mono" FontSize="12" />
                        <Label Grid.Column="1" Text="{Binding IdText}" FontFamily="Mono" FontSize="12" />
                        <Label Grid.Column="2" Text="{Binding Dlc}" FontFamily="Mono" FontSize="12" />
                        <Label Grid.Column="3" Text="{Binding DataText}" FontFamily="Mono" FontSize="12" />
                        <Label Grid.Column="4" Text="{Binding SignalSummaryText}" FontFamily="Mono" FontSize="12" LineBreakMode="TailTruncation" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRowTapped" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            </CollectionView>
            <Label Text="{Binding SeekProgressText}" FontSize="24" FontAttributes="Bold"
                   TextColor="Orange" IsVisible="{Binding IsSeekBusy}"
                   HorizontalOptions="Center" VerticalOptions="Center"
                   BackgroundColor="#80000000" Padding="20,12" />
        </Grid>

        <Grid x:Name="ChartGrid" Grid.Row="3" IsVisible="False" RowDefinitions="Auto,*,Auto" RowSpacing="8">
            <HorizontalStackLayout Grid.Row="0" Spacing="8">
                <Button Text="选择信号" Clicked="OnSelectSignalClicked" />
                <Label x:Name="SelectedSignalsLabel" VerticalOptions="Center" LineBreakMode="MiddleTruncation" />
                <Button Grid.Column="1" x:Name="ZoomInButton" Text="＋" WidthRequest="44" Clicked="OnZoomInClicked" />
                <Button x:Name="ZoomOutButton" Text="－" WidthRequest="44" Clicked="OnZoomOutClicked" />
                <Button x:Name="ResetZoomButton" Text="复位" WidthRequest="64" Clicked="OnResetZoomClicked" />
            </HorizontalStackLayout>
            <lvc:CartesianChart Grid.Row="1" x:Name="SignalChart" />
            <Label x:Name="ChartEmptyLabel" Grid.Row="2" Text="请选择 1–2 个 DBC 信号" HorizontalOptions="Center" TextColor="Gray" />
        </Grid>

        <HorizontalStackLayout x:Name="StatusRow" Grid.Row="4" Spacing="12" Margin="0,4">
            <Label Text="{Binding CacheStatusText}" FontSize="12" TextColor="Gray" />
            <Label Text="{Binding SkippedLinesText}" FontSize="12" TextColor="Orange" />
        </HorizontalStackLayout>

        <HorizontalStackLayout x:Name="FilterRow" Grid.Row="5" Spacing="8">
            <Entry x:Name="FilterEntry" Placeholder="ID 过滤 (hex, 逗号分隔)" WidthRequest="200"
                   Completed="OnFilterCompleted" />
            <Button Text="↓ 最新" Clicked="OnJumpLatest" />
        </HorizontalStackLayout>

        <HorizontalStackLayout x:Name="TabRow" Grid.Row="6" Spacing="8">
            <Button x:Name="TableTabButton" Text="表格" Clicked="OnShowTableClicked" />
            <Button x:Name="ChartTabButton" Text="图表" Clicked="OnShowChartClicked" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>



