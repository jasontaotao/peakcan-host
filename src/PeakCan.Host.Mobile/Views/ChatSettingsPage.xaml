<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PeakCan.Host.Mobile.Views.ChatSettingsPage"
             Title="AI 设置">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label Text="LLM 配置" FontAttributes="Bold" FontSize="16" />

            <Label Text="厂商" FontSize="13" />
            <Picker ItemsSource="{Binding ChatProviders}" SelectedItem="{Binding ChatSelectedProvider}" />

            <Label Text="模型" FontSize="13" />
            <Entry Text="{Binding ChatModelInput}" Placeholder="deepseek-chat" />

            <Label Text="别名" FontSize="13" />
            <Entry Text="{Binding ChatNewKeyAlias}" Placeholder="default" />

            <Label Text="API Key" FontSize="13" />
            <Entry Text="{Binding ChatApiKeyInput}" IsPassword="True" Placeholder="sk-..." />

            <Label Text="API Base（自定义厂商）" FontSize="13" IsVisible="{Binding IsCustomChatProvider}" />
            <Entry Text="{Binding ChatCustomApiBase}" Placeholder="https://..." IsVisible="{Binding IsCustomChatProvider}" />

            <Button Text="测试连接并保存" Clicked="OnTestAndSaveClicked" />
            <Label Text="{Binding ChatConnectionStatus}" FontSize="12" TextColor="Gray" />
            <Button Text="重置配置" Clicked="OnResetClicked" />

            <Label Text="已保存的 Key" FontAttributes="Bold" FontSize="16" Margin="0,8,0,0" />
            <CollectionView ItemsSource="{Binding ChatSavedKeys}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="0,4">
                            <VerticalStackLayout>
                                <Label Text="{Binding DisplayName}" FontSize="14">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="TextColor" Value="Green" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding Model}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="切换" Clicked="OnSwitchClicked" />
                            <Button Grid.Column="2" Text="删除" Clicked="OnDeleteClicked" TextColor="Red" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
