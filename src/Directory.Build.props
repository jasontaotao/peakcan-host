<Project>
  <!-- Inherit the repo-root defaults (LangVersion, Nullable, ImplicitUsings,
       TreatWarningsAsErrors, analyzers). MSBuild stops at the NEAREST
       Directory.Build.props, so without this Import the shipped projects
       silently lost the root quality gate. (F1-1) -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- v3.13.3 PATCH F6: window title version. Generated by the Tier 3 ship
         script (its target is src/Directory.Build.props). Manual edits get
         overwritten on the next ship. This is the SINGLE SOURCE OF TRUTH for
         the shipping version — the repo-root file deliberately declares none. -->
    <Version>3.65.0</Version>
    <AssemblyVersion>3.65.0.0</AssemblyVersion>
    <FileVersion>3.65.0.0</FileVersion>
    <InformationalVersion>3.65.0</InformationalVersion>

    <!-- The root enables the full Recommended analyzer rule set, but the shipped
         code still carries ~750 outstanding CA-rule findings (CA1848 x216,
         CA1305 x182, CA1873 x62, ...). Promoting src/ to Recommended is a tracked
         follow-up; until then keep the compiler-warning gate (TreatWarningsAsErrors,
         inherited above) while analysis stays at the default level so the build
         stays green. -->
    <AnalysisMode>Default</AnalysisMode>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
