<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PeakCan.Tools.PromptCacheProbe</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- Diagnostic tool: P/Invoke + permissive console error handling;
         keep the usual analyzer noise out of an operator-facing probe. -->
    <NoWarn>$(NoWarn);CA1031;CA1305;CA1307;CA1812;CA1822;CA2007;CA2208;CA1051;CA1707</NoWarn>
  </PropertyGroup>
</Project>
